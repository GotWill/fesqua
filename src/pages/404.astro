---
import Layout from '../layouts/Layout.astro';
import { getLang, route, t } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const links = [
	{ href: route(lang, 'sobreEvento'), label: t(lang, 'nav.about') },
	{ href: route(lang, 'listaExpositores'), label: t(lang, 'nav.exhibitors') },
	{ href: route(lang, 'plantaFeira'), label: t(lang, 'nav.floorplan') },
	{ href: route(lang, 'contato'), label: t(lang, 'nav.contact') },
];
---

<Layout title={t(lang, 'nf.title')} description={t(lang, 'nf.desc')}>
	<main class="nf on-primary" aria-labelledby="nf-title">
		<span class="nf-dots" aria-hidden="true"></span>

		<div class="nf-inner">
			<div class="nf-copy">
				<h1 id="nf-title">
					<span class="nf-lead">{t(lang, 'nf.lead')}</span>
					<span class="nf-strong">{t(lang, 'nf.strong')}</span>
				</h1>
				<p class="nf-text">{t(lang, 'nf.text')}</p>

				<div class="nf-ctas">
					<a href={route(lang, 'home')} class="btn nf-btn btn-lg">
						<div class="slime"><span></span><span></span><span></span></div>
						<div class="btn-content"><span>{t(lang, 'nf.home')}</span></div>
					</a>
					<a href={route(lang, 'contato')} class="btn Outline_White btn-lg">
						<div class="slime"><span></span><span></span><span></span></div>
						<div class="btn-content"><span>{t(lang, 'nf.contact')}</span></div>
					</a>
				</div>

				<nav class="nf-links" aria-label={t(lang, 'nf.links')}>
					{links.map((l) => <a href={l.href}>{l.label}</a>)}
				</nav>
			</div>

			<div class="nf-art" aria-hidden="true">
				<span class="nf-num">404</span>
			</div>
		</div>
	</main>
</Layout>

<style>
	/* a onda do topo do rodapé não aparece nesta página */
	:global(.site-footer .wave) {
		display: none;
	}
	.nf {
		position: relative;
		overflow: hidden;
		display: flex;
		align-items: center;
		min-height: 100vh;
		min-height: 100svh;
		box-sizing: border-box;
		padding: clamp(7rem, 14vw, 9rem) clamp(1.5rem, 5vw, 4rem) clamp(3rem, 8vw, 5rem);
		background: linear-gradient(45deg, var(--color-primary-deep) 0%, var(--color-primary) 60%);
		color: var(--color-white);
	}
	.nf-dots {
		position: absolute;
		top: 50%;
		right: clamp(1rem, 6vw, 6rem);
		width: 420px;
		height: 360px;
		transform: translateY(-50%);
		background-image: radial-gradient(var(--color-red-700) 1.5px, transparent 1.5px);
		background-size: 18px 18px;
		-webkit-mask-image: radial-gradient(ellipse at center, black 45%, transparent 80%);
		mask-image: radial-gradient(ellipse at center, black 45%, transparent 80%);
		pointer-events: none;
	}
	.nf-inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 1280px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(2rem, 5vw, 4rem);
	}
	h1 {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin: 0;
	}
	.nf-lead {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(1.25rem, 2.4vw, 1.75rem);
		color: var(--color-white);
	}
	.nf-strong {
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.01em;
		font-size: clamp(2.25rem, 6vw, 4.5rem);
		line-height: 1.05;
		color: var(--color-blush);
	}
	.nf-text {
		margin: 1.25rem 0 0;
		max-width: 46ch;
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--color-rose-200);
	}
	.nf-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		margin-top: 1.75rem;
	}
	.nf-btn {
		--bg-color: var(--color-blush);
		--text-color: var(--color-primary-deep);
		--hover-bg-color: var(--color-white);
		--hover-text-color: var(--color-primary-deep);
		--pressed-bg-color: var(--color-rose-300);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.9375rem;
		letter-spacing: 0.02em;
	}
	.nf-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.75rem;
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.2);
	}
	.nf-links a {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.875rem;
		color: var(--color-blush);
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-thickness: 1px;
		transition: color 0.2s;
	}
	.nf-links a:hover {
		color: #fff;
	}
	.nf :is(a, button):focus-visible {
		outline: 2px solid var(--color-blush);
		outline-offset: 4px;
	}

	.nf-art {
		position: relative;
		flex: none;
		display: grid;
		place-items: center;
	}
	.nf-num {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(8rem, 20vw, 17rem);
		line-height: 1;
		letter-spacing: -0.04em;
		color: transparent;
		-webkit-text-stroke: 2px rgba(255, 206, 197, 0.45);
		user-select: none;
	}
	@media (max-width: 900px) {
		.nf-inner {
			flex-direction: column;
			align-items: flex-start;
		}
		.nf-art {
			order: -1;
			align-self: flex-start;
		}
		.nf-dots {
			display: none;
		}
		.nf-num {
			font-size: clamp(5rem, 28vw, 8rem);
		}
	}
	@media (max-width: 480px) {
		.nf-ctas :global(.btn) {
			width: 100%;
			justify-content: center;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.nf-links a {
			transition: none;
		}
	}
</style>
