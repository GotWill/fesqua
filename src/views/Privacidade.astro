---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import PartnersSection from '../components/PartnersSection.astro';
import { policy, CONTROLLER } from '../data/privacy-policy';
import { getLang, pick } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const { sections, summary, hero, pageTitle, description } = pick(policy, lang);

const pad = (n: number) => String(n).padStart(2, '0');
// separa o texto em pedaços para transformar URLs soltas em links (sem pontuação final no link)
const parts = (text: string) =>
	text
		.split(/(https?:\/\/[^\s)]+)/g)
		.filter(Boolean)
		.map((s) => {
			if (!/^https?:\/\//.test(s)) return { s, href: '' };
			const clean = s.replace(/[.,;]+$/, '');
			return { s: clean, href: clean, tail: s.slice(clean.length) };
		});
---

<Layout
	title={pageTitle}
	description={description}
>
	<PageHero lineA={hero[0]} lineB={hero[1]} id="pp-title" />

	<div class="c pp">
		<p class="owner">{CONTROLLER}</p>

		<nav class="toc" aria-labelledby="toc-t">
			<h2 id="toc-t">{summary}</h2>
			<ol>
				{
					sections.map((s, i) => (
						<li>
							<a href={`#${s.id}`}>
								<span class="inum">{pad(i + 1)}</span>
								<span>{s.title}</span>
							</a>
						</li>
					))
				}
			</ol>
		</nav>

		<div class="arts">
			{
				sections.map((s, i) => (
					<article class="art" id={s.id} aria-labelledby={`h-${s.id}`}>
						<span class="a-num" aria-hidden="true">{pad(i + 1)}</span>
						<div>
							<h2 id={`h-${s.id}`}>{s.title}</h2>
							<div class="ans">
								{s.blocks.map((b) => (
									<>
										{b.t === 'p' && (
											<p>
												{parts(b.x).map((p) =>
													p.href ? (
														<Fragment>
															<a href={p.href} target="_blank" rel="noopener">{p.s}</a>
															{p.tail}
														</Fragment>
													) : (
														p.s
													),
												)}
											</p>
										)}
										{b.t === 'h' && <h3>{b.x}</h3>}
										{b.t === 'note' && <p class="note">{b.x}</p>}
										{b.t === 'ul' && (
											<ul>
												{b.x.map((item) => (
													<li>
														{parts(item).map((p) =>
															p.href ? (
																<Fragment>
																	<a href={p.href} target="_blank" rel="noopener">{p.s}</a>
																	{p.tail}
																</Fragment>
															) : (
																p.s
															),
														)}
													</li>
												))}
											</ul>
										)}
									</>
								))}
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>

	<PartnersSection />
</Layout>

<style>
	.c {
		max-width: 1040px;
		margin-inline: auto;
		padding-inline: clamp(1.25rem, 4vw, 3rem);
	}
	.pp {
		padding-block: 2.75rem 6rem;
	}
	.owner {
		margin: 0 0 2rem;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 0.8125rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-primary);
	}

	/* ---------- resumo ---------- */
	.toc {
		padding: 1.75rem clamp(1.25rem, 3vw, 2rem);
		border: 1px solid var(--color-line);
		border-radius: 1rem;
		background: var(--color-rose-50);
	}
	.toc h2 {
		margin: 0 0 1rem;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.25rem;
		color: var(--color-primary);
	}
	.toc ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 2rem;
	}
	.toc a {
		display: grid;
		grid-template-columns: 30px 1fr;
		gap: 0.5rem;
		padding: 0.55rem 0.5rem;
		border-radius: 0.5rem;
		font-size: 0.9375rem;
		line-height: 1.4;
		color: var(--color-ink);
		transition:
			background 0.2s,
			color 0.2s;
	}
	.toc a:hover,
	.toc a:focus-visible {
		background: #fff;
		color: var(--color-primary);
		outline: 0;
	}
	.inum {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.6875rem;
		color: var(--color-primary);
		padding-top: 0.2rem;
		font-variant-numeric: tabular-nums;
	}

	/* ---------- seções ---------- */
	.arts {
		margin-top: 2.5rem;
	}
	.art {
		display: grid;
		grid-template-columns: 84px minmax(0, 1fr);
		gap: 1.5rem;
		padding: 2.75rem 0;
		border-top: 1px solid var(--color-line);
		scroll-margin-top: calc(var(--header-h) + 1rem);
	}
	.a-num {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(2rem, 3.4vw, 3rem);
		line-height: 1;
		color: rgba(156, 12, 12, 0.2);
		font-variant-numeric: tabular-nums;
	}
	.art h2 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.25rem, 2vw, 1.625rem);
		line-height: 1.3;
		color: var(--color-primary);
		margin: 0 0 1.25rem;
		max-width: 40ch;
		letter-spacing: -0.005em;
	}
	.ans {
		font-family: var(--font-body);
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--color-ink);
	}
	.ans p {
		margin: 0 0 1rem;
		max-width: 72ch;
	}
	.ans h3 {
		margin: 1.75rem 0 0.6rem;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.0625rem;
		line-height: 1.35;
		color: var(--color-text);
	}
	.ans ul {
		margin: 0 0 1rem;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.6rem;
		max-width: 72ch;
	}
	.ans li {
		position: relative;
		padding-left: 1.4rem;
	}
	.ans li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.8em;
		width: 0.8rem;
		height: 2px;
		background: var(--color-primary-bright);
	}
	.ans .note {
		padding: 1rem 1.25rem;
		border-left: 3px solid var(--color-primary-bright);
		background: var(--color-rose-50);
		border-radius: 0 0.5rem 0.5rem 0;
		font-size: 0.9375rem;
	}
	.ans > :last-child {
		margin-bottom: 0;
	}
	.ans a {
		color: var(--color-primary);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		overflow-wrap: anywhere;
		transition: color 0.2s;
	}
	.ans a:hover {
		color: var(--color-primary-bright);
	}

	@media (max-width: 760px) {
		.toc ol {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 640px) {
		.art {
			grid-template-columns: 1fr;
			gap: 0.5rem;
			padding: 2rem 0;
		}
		.a-num {
			font-size: 1.75rem;
		}
		.art h2 {
			max-width: none;
		}
		.ans {
			font-size: 1rem;
		}
	}
</style>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>
