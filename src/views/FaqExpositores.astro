---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import PartnersSection from '../components/PartnersSection.astro';
import { content } from '../data/duvidas-frequentes-expositores';
import { getLang, pick } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const c = pick(content, lang);
const faq = c.faq;
const [titleA, titleB] = c.title;
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout title={c.metaTitle} description={c.metaDesc}>
    <PageHero lineA={`${titleA} –`} lineB={titleB} id="faq-title" />
    <div class="c faq">
        <details class="dd" id="dd">
            <summary>{c.jump}</summary>
            <nav class="dd-panel" aria-label={c.navLabel}>
                <ol>
                    {
                        faq.map((q) => (
                            <li>
                                <a href={`#p-${q.n}`}>
                                    <span class="inum">{pad(q.n)}</span>
                                    <span class="it">{q.q}</span>
                                </a>
                            </li>
                        ))
                    }
                </ol>
            </nav>
        </details>

        <div class="arts">
            {
                faq.map((q) => (
                    <article class="art" id={`p-${q.n}`} aria-labelledby={`h-${q.n}`}>
                        <span class="a-num" aria-hidden="true">{pad(q.n)}</span>
                        <div>
                            <h2 id={`h-${q.n}`}>{q.q}</h2>
                            <div class="ans">
                                {q.blocks.map((b) => (
                                    <>
                                        {b.type === 'p' && (
                                            <p>
                                                {b.text.split('\n').map((line, i) => (
                                                    <>
                                                        {i > 0 && <br />}
                                                        {line}
                                                    </>
                                                ))}
                                            </p>
                                        )}
                                        {b.type === 'labeled' && (
                                            <p>
                                                <strong>{b.label}</strong> {b.text}
                                            </p>
                                        )}
                                        {b.type === 'warn' && (
                                            <p class="warn">
                                                {b.label && <strong>{b.label}</strong>} {b.text}
                                            </p>
                                        )}
                                        {b.type === 'list' && (
                                            <ul class="dash">
                                                {b.items.map((item) => (
                                                    <li>{item}</li>
                                                ))}
                                            </ul>
                                        )}
                                        {b.type === 'place' && <p class="place">{b.text}</p>}
                                        {b.type === 'address' && <p class="addr">{b.text}</p>}
                                        {b.type === 'maplink' && (
                                            <p>
                                                <a href={b.href} target="_blank" rel="noopener">{b.text}</a>
                                            </p>
                                        )}
                                        {b.type === 'contact' && (
                                            <address class="contact">
                                                <span class="org">{b.org}</span>
                                                {b.lines.map((l) => (
                                                    <>
                                                        <br />
                                                        {l.prefix}<a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.link}</a>{l.suffix}
                                                    </>
                                                ))}
                                            </address>
                                        )}
                                        {b.type === 'table' && (
                                            <table class="agenda">
                                                <caption>{b.title}</caption>
                                                <tbody>
                                                    {b.rows.map((r) => (
                                                        <tr>
                                                            <th scope="row">{r.label}</th>
                                                            <td>{r.value}</td>
                                                        </tr>
                                                    ))}
                                                </tbody>
                                            </table>
                                        )}
                                    </>
                                ))}
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>

    <PartnersSection />
</Layout>

<style>
    .c {
        max-width: 1040px;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 4vw, 3rem);
    }

    /* ---------- dropdown simples ---------- */
    .faq {
        padding-block: 2.75rem 6rem;
    }
    .dd {
        position: relative;
        z-index: 5;
        max-width: 560px;
    }
    .dd summary {
        list-style: none;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 0.95rem 1.4rem;
        border: 1px solid var(--color-line);
        border-radius: 9999px;
        background: #fff;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.875rem;
        color: var(--color-primary);
        transition:
            border-color 0.25s,
            box-shadow 0.25s;
    }
    .dd summary::-webkit-details-marker {
        display: none;
    }
    .dd summary:hover {
        border-color: var(--color-primary);
    }
    .dd summary:focus-visible {
        outline: 2px solid var(--color-primary-bright);
        outline-offset: 3px;
    }
    .dd[open] summary {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(156, 12, 12, 0.12);
    }
    .dd summary::after {
        content: '';
        width: 8px;
        height: 8px;
        border-right: 2px solid var(--color-primary);
        border-bottom: 2px solid var(--color-primary);
        transform: translateY(-2px) rotate(45deg);
        transition: transform 0.3s var(--ease-in-out);
    }
    .dd[open] summary::after {
        transform: translateY(2px) rotate(-135deg);
    }
    .dd-panel {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 0.5rem);
        background: #fff;
        border: 1px solid var(--color-line);
        border-radius: 1rem;
        padding: 0.5rem;
        max-height: min(60vh, 440px);
        overflow: auto;
        box-shadow: 0 24px 50px -20px rgba(73, 3, 6, 0.35);
        scrollbar-width: thin;
        scrollbar-color: var(--color-rose-300) transparent;
    }
    .dd[open] .dd-panel {
        animation: ddin 0.25s var(--ease-out);
    }
    @keyframes ddin {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
    .dd-panel ol {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .dd-panel a {
        display: grid;
        grid-template-columns: 30px 1fr;
        gap: 0.5rem;
        padding: 0.65rem 0.75rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        line-height: 1.4;
        color: var(--color-ink);
        transition:
            background 0.2s,
            color 0.2s;
    }
    .dd-panel a:hover,
    .dd-panel a:focus-visible {
        background: var(--color-rose-50);
        color: var(--color-primary);
        outline: 0;
    }
    .inum {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.6875rem;
        color: var(--color-primary);
        padding-top: 0.1rem;
        font-variant-numeric: tabular-nums;
    }

    /* ---------- perguntas ---------- */
    .arts {
        margin-top: 1rem;
    }
    .art {
        display: grid;
        grid-template-columns: 84px minmax(0, 1fr);
        gap: 1.5rem;
        padding: 2.75rem 0;
        border-top: 1px solid var(--color-line);
        scroll-margin-top: calc(var(--header-h) + 1rem);
    }
    .a-num {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: clamp(2rem, 3.4vw, 3rem);
        line-height: 1;
        color: rgba(156, 12, 12, 0.2);
        font-variant-numeric: tabular-nums;
    }
    .art h2 {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.25rem, 2vw, 1.625rem);
        line-height: 1.3;
        color: var(--color-primary);
        margin: 0 0 1.1rem;
        max-width: 34ch;
        letter-spacing: -0.005em;
    }

    /* ---------- respostas ---------- */
    .ans {
        font-family: var(--font-body);
        font-size: 1.0625rem;
        line-height: 1.7;
        color: var(--color-ink);
    }
    .ans p {
        margin: 0 0 1rem;
        max-width: 68ch;
    }
    .ans > :last-child {
        margin-bottom: 0;
    }
    .ans strong {
        font-family: var(--font-display);
        font-weight: 700;
        color: var(--color-text);
    }
    .ans a {
        color: var(--color-primary);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
        transition: color 0.2s;
    }
    .ans a:hover {
        color: var(--color-primary-bright);
    }
    .ans .place {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.125rem;
        color: var(--color-primary);
    }
    .ans .addr {
        padding-left: 1rem;
        border-left: 3px solid var(--color-primary-bright);
    }
    .ans .warn {
        background: var(--color-rose-50);
        border-left: 3px solid var(--color-primary);
        padding: 1rem 1.25rem;
        border-radius: 0 0.5rem 0.5rem 0;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.9375rem;
        line-height: 1.6;
        color: var(--color-primary-deep);
    }
    .ans .warn strong {
        color: var(--color-primary);
    }
    .ans ul.dash {
        list-style: none;
        margin: 0 0 1rem;
        padding: 0;
        max-width: 68ch;
    }
    .ans ul.dash li {
        position: relative;
        padding: 0.35rem 0 0.35rem 1.6rem;
    }
    .ans ul.dash li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 1.05rem;
        width: 0.85rem;
        height: 2px;
        background: var(--color-primary-bright);
    }
    .ans .contact {
        font-style: normal;
        margin: 0 0 1rem;
        padding: 1rem 1.25rem;
        border-left: 3px solid var(--color-primary-bright);
        background: var(--color-rose-50);
        border-radius: 0 0.5rem 0.5rem 0;
        max-width: 68ch;
    }
    .ans .contact .org {
        font-family: var(--font-display);
        font-weight: 700;
        color: var(--color-primary);
    }

    /* tabela da pergunta 3 */
    .ans table.agenda {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0 0 1.25rem;
        border: 1px solid var(--color-line);
        border-radius: 0.75rem;
        overflow: hidden;
    }
    .ans .agenda caption {
        caption-side: top;
        text-align: left;
        padding: 1rem 1.25rem;
        background: linear-gradient(115deg, var(--color-primary-deep), var(--color-primary));
        color: #fff;
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 0.9375rem;
        letter-spacing: 0.06em;
    }
    .ans .agenda th,
    .ans .agenda td {
        padding: 1rem 1.25rem;
        text-align: left;
        vertical-align: top;
        border-top: 1px solid var(--color-line);
        line-height: 1.55;
    }
    .ans .agenda tr:first-child th,
    .ans .agenda tr:first-child td {
        border-top: 0;
    }
    .ans .agenda th {
        width: 30%;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.8125rem;
        letter-spacing: 0.06em;
        color: var(--color-primary);
        background: var(--color-rose-50);
    }
    .ans .agenda td {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 0.9375rem;
        color: var(--color-text);
    }

    @media (max-width: 640px) {
        .dd {
            max-width: none;
        }
        .art {
            grid-template-columns: 1fr;
            gap: 0.5rem;
            padding: 2rem 0;
        }
        .a-num {
            font-size: 1.75rem;
        }
        .art h2 {
            max-width: none;
        }
        .ans {
            font-size: 1rem;
        }
        /* a tabela vira uma pilha de cartões; a legenda precisa entrar na lista */
        .ans .agenda,
        .ans .agenda tbody,
        .ans .agenda tr,
        .ans .agenda th,
        .ans .agenda td,
        .ans .agenda caption {
            display: block;
            width: 100%;
        }
        .ans .agenda tr {
            border-top: 1px solid var(--color-line);
        }
        .ans .agenda tr:first-child {
            border-top: 0;
        }
        .ans .agenda th,
        .ans .agenda td {
            border-top: 0;
            padding: 0.7rem 1rem;
        }
        .ans .agenda th {
            padding-bottom: 0.4rem;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .dd[open] .dd-panel {
            animation: none;
        }
        .dd summary::after {
            transition: none;
        }
    }
    @media print {
        .dd {
            display: none;
        }
    }
</style>

<style is:global>
    html {
        scroll-behavior: smooth;
    }
    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }
    }
</style>

<script>
    const dd = document.getElementById('dd') as HTMLDetailsElement | null;
    if (dd) {
        // escolher uma pergunta fecha a lista; clicar fora ou apertar Esc também
        dd.querySelectorAll('a').forEach((a) =>
            a.addEventListener('click', () => {
                dd.open = false;
            }),
        );
        document.addEventListener('click', (e) => {
            if (dd.open && !dd.contains(e.target as Node)) dd.open = false;
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && dd.open) {
                dd.open = false;
                (dd.querySelector('summary') as HTMLElement).focus();
            }
        });
    }
</script>
