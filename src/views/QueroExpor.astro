		opacity: 0;
		transform: translateY(-34px) rotate(calc(var(--r) * 4));
		transition:
			opacity 0.5s var(--ease-out) var(--d, 0s),
			transform 1.05s cubic-bezier(0.34, 1.56, 0.64, 1) var(--d, 0s),
			box-shadow 0.4s;
