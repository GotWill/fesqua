</style>

<script>
	// revela cada bloco ao entrar na tela (só se o script inline do topo ligou o modo animado)
	if (document.documentElement.classList.contains('qe-anim')) {
		const io = new IntersectionObserver(
			(entries) =>
				entries.forEach((e) => {
					if (e.isIntersecting) {
						e.target.classList.add('in');
						io.unobserve(e.target);
					}
				}),
			{ threshold: 0.25 },
		);
		document.querySelectorAll('.qe-rv').forEach((el) => io.observe(el));
	}
</script>