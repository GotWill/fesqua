		transform: scaleX(0);
		transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1) 0.15s;
	}
	:global(.qe-anim) .lvl.in .ln {
		transform: scaleX(1);
	}
	:global(.qe-anim) .lvl .nd {
		transform: scale(0.3);
		opacity: 0;
		transition:
			transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s,
			opacity 0.4s 0.5s;
	}
	:global(.qe-anim) .lvl.in .nd {
		transform: none;
		opacity: 1;
	}
	:global(.qe-anim) .lvl .check {
