---
import Layout from '../layouts/Layout.astro';
import JanelaDraw from '../components/JanelaDraw.astro';
import PartnersSection from '../components/PartnersSection.astro';
import { getLang, pick } from '../i18n/utils';
import { queroExpor } from '../i18n/content/quero-expor';

const lang = getLang(Astro.currentLocale);
const c = pick(queroExpor, lang);

/* ===================================================================
   CONTEÚDO — textos em src/i18n/content/quero-expor.ts.
   =================================================================== */
const hero = {
	lead: c.lead,
	text: c.heroText,
};

// span = largura do estande na planta (de 12 colunas). Cada linha de 3 estandes soma 12.
const BOOTH_SPANS = [5, 4, 3, 3, 5, 4, 3, 6, 3, 4, 3, 5, 3, 5, 4];
const expoe = {
	title: c.expoeTitle,
	booths: c.booths.map((text, i) => ({ text, span: BOOTH_SPANS[i] })),
};

const visita = {
	title: c.visitaTitle,
	badges: c.badges,
};

const cta = {
	line1: c.ctaLine1,
	line2: c.ctaLine2,
	label: c.ctaLabel,
	href: ''
};

const motivos = {
	title1: c.motivosTitle1,
	title2: c.motivosTitle2,
	items: c.motivos,
};

/* ---------- derivados (nada aqui é conteúdo) ---------- */
const h1a = c.h1a;
const h1b = c.h1b;
const pad = (n: number) => String(n).padStart(2, '0');

// contorno "serrilhado" do selo com check
const sealPath = (() => {
	const n = 14, R = 41, a = 3.4, steps = 280;
	const pts: string[] = [];
	for (let i = 0; i < steps; i++) {
		const t = (2 * Math.PI * i) / steps;
		const r = R + a * Math.cos(n * t);
		pts.push(`${(r * Math.cos(t)).toFixed(2)} ${(r * Math.sin(t)).toFixed(2)}`);
	}
	return 'M' + pts.join(' L') + 'Z';
})();
---

<Layout title={c.title} description={c.description}>
	<div class="qe">
	{/* Liga o modo animado ANTES do conteúdo abaixo ser desenhado (evita o "pisca"). Com "reduzir movimento"
	    ou sem JavaScript a classe não entra e tudo já aparece visível/aceso. */}
	<script is:inline>
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
			document.documentElement.classList.add('qe-anim');
		}
	</script>

	<svg width="0" height="0" style="position:absolute" aria-hidden="true">
		<defs>
			<linearGradient id="qe-sealg" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color="#E03A30"></stop>
				<stop offset="1" stop-color="#9C0C0C"></stop>
			</linearGradient>
		</defs>
	</svg>

	<!-- ============ HERO ============ -->
	<section class="qe-hero" aria-labelledby="qe-t">
		<JanelaDraw color="var(--color-primary)" size="84px" class="qe-janela" />
		<div class="c">
			<h1 class="qe-h1" id="qe-t">{h1a} <span>{h1b}</span></h1>
			<div class="qe-intro">
				<p class="qe-lead">{hero.lead}</p>
				<p class="qe-text">{hero.text.map((p) => (typeof p === 'string' ? p : <strong>{p.b}</strong>))}</p>
			</div>
		</div>
	</section>

	<!-- ============ QUEM EXPÕE: planta baixa ============ -->
	<section class="qe-plan" aria-labelledby="qe-e">
		<div class="c">
			<h2 class="qe-sec-h" id="qe-e">{expoe.title}</h2>
			<div class="qe-cota" aria-hidden="true"></div>
			<ul class="qe-booths" role="list">
				{
					expoe.booths.map((b, i) => (
						<li class="booth qe-rv" style={`--s:${b.span};--d:${Math.min(i * 55, 700)}ms`}>
							<span class="bn" aria-hidden="true">{pad(i + 1)}</span>
							<span class="bt">{b.text}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ============ QUEM VISITA: crachás ============ -->
	<section class="qe-visit" aria-labelledby="qe-v">
		<div class="c">
			<h2 class="qe-sec-h" id="qe-v">{visita.title}</h2>
			<ul class="qe-badges" role="list">
				{
					visita.badges.map((t, i) => (
						<li class="badge qe-rv" style={`--d:${(i % 4) * 110 + Math.floor(i / 4) * 60}ms`}>
							<svg class="wm" viewBox="0 0 40 40" fill="none" aria-hidden="true">
								<rect x="3" y="3" width="34" height="34" rx="5" stroke="currentColor" stroke-width="2.4"></rect>
								<path d="M20 3v34M3 20h34" stroke="currentColor" stroke-width="2.4"></path>
							</svg>
							<span class="bt">{t}</span>
							<span class="bars" aria-hidden="true"></span>
							<span class="band" aria-hidden="true"></span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- ============ CTA: pôster com diagonal ============ -->
	<section class="qe-cta" aria-labelledby="qe-c">
		<div class="c cta-in">
			<div class="cta-txt">
				<h2 class="cta-h" id="qe-c"><span class="l1">{cta.line1}</span><span class="l2">{cta.line2}</span></h2>
				<div class="cta-cota qe-rv" aria-hidden="true"></div>
				<a class="cta-btn" href={cta.href}>
					<span class="lbl">{cta.label}</span>
					<span class="arr" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
							<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
						</svg>
					</span>
				</a>
			</div>
			<div class="cta-art" aria-hidden="true">
				<JanelaDraw color="var(--color-blush)" size="min(28vw, 340px)" label="" />
			</div>
		</div>
	</section>

	<!-- ============ MOTIVOS: fachada em elevação ============ -->
	<section class="qe-mot" aria-labelledby="qe-m">
		<div class="c">
			<h2 id="qe-m"><span class="mot-1">{motivos.title1}</span><span class="mot-2">{motivos.title2}</span></h2>

			<div class="elev">
				<div class="r3 roofrow qe-rv">
					<div class="roof" aria-hidden="true">
						<svg class="sign" viewBox="0 0 40 40" fill="none" aria-hidden="true">
							<rect x="3" y="3" width="34" height="34" rx="5" stroke="currentColor" stroke-width="2.4"></rect>
							<path d="M20 3v34M3 20h34" stroke="currentColor" stroke-width="2.4"></path>
						</svg>
						<i class="ant a1"></i><i class="ant a2"></i>
					</div>
				</div>

				<ol class="lvls" role="list">
					{
						motivos.items.map((t, i) => (
							<li class:list={['lvl', 'r3', i % 2 === 0 ? 'L' : 'R', 'qe-rv']} style={`--i:${i}`}>
								<div class="cl">
									<p class="bt">{t}</p>
									<span class="ln" aria-hidden="true"></span>
									<span class="nd" aria-hidden="true">
										<svg class="seal" viewBox="-50 -50 100 100" aria-hidden="true">
											<path d={sealPath} fill="url(#qe-sealg)"></path>
											<path class="check" pathLength="1" d="M-15 1 L-4.5 12 L16 -11" fill="none" stroke="#fff" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round"></path>
										</svg>
									</span>
								</div>
								<div class="flr" aria-hidden="true"><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i></div>
							</li>
						))
					}
				</ol>

				<div class="r3 baserow qe-rv">
					<div class="base" aria-hidden="true"><span class="door"><i></i><i></i></span></div>
				</div>
			</div>
		</div>
		<div class="ground" aria-hidden="true"></div>
	</section>
	</div>

    <PartnersSection />
</Layout>

<style>
	/* a página não depende de resets globais do projeto */
	.qe {
		text-rendering: geometricPrecision;
		-webkit-font-smoothing: antialiased;
	}
	.qe svg {
		display: block;
	}
	.qe-mot h2 {
		margin: 0;
	}

	.c {
		max-width: 1280px;
		margin-inline: auto;
		padding-inline: clamp(1.25rem, 4vw, 3rem);
	}
	.qe-hero :global(.qe-janela) {
		position: absolute;
		right: clamp(1.25rem, 4vw, 3rem);
		top: 2.5rem;
		width: 84px;
		--ink: var(--color-primary);
	}

	/* ====================== HERO (mesmo papel milimetrado das outras páginas) ====================== */
	.qe-hero {
		position: relative;
		overflow: hidden;
		background-color: var(--color-rose-50);
		border-bottom: 1px solid var(--color-line);
		background-image:
			linear-gradient(rgba(156, 12, 12, 0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(156, 12, 12, 0.06) 1px, transparent 1px),
			linear-gradient(rgba(156, 12, 12, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(156, 12, 12, 0.035) 1px, transparent 1px);
		background-size:
			96px 96px,
			96px 96px,
			24px 24px,
			24px 24px;
	}
	.qe-hero .c {
		padding-block: 5rem;
	}
	.qe-h1 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(2.125rem, 9vw, 8rem);
		line-height: 0.92;
		letter-spacing: -0.03em;
		color: var(--color-primary);
	}
	.qe-h1 span {
		display: block;
		color: var(--color-text);
	}
	.qe-intro {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		column-gap: clamp(2rem, 5vw, 5rem);
		margin-top: clamp(2rem, 4vw, 3.5rem);
		padding-top: 1.75rem;
		border-top: 1px solid var(--color-rose-300);
	}
	.qe-lead {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.25rem, 2.1vw, 1.75rem);
		line-height: 1.35;
		color: var(--color-text);
		max-width: 26ch;
	}
	.qe-text {
		margin: 0;
		font-size: 1.125rem;
		line-height: 1.75;
		color: var(--color-ink);
		max-width: 54ch;
	}
	.qe-text strong {
		font-family: var(--font-display);
		font-weight: 800;
		color: var(--color-primary);
	}

	/* ====================== QUEM EXPÕE — planta baixa ====================== */
	.qe-plan {
		position: relative;
		color: #fff;
		padding: 6.5rem 0 7rem;
		background:
			linear-gradient(rgba(255, 206, 197, 0.055) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 206, 197, 0.055) 1px, transparent 1px),
			linear-gradient(rgba(255, 206, 197, 0.025) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 206, 197, 0.025) 1px, transparent 1px), radial-gradient(90% 70% at 0% 0%, #5a0a0d 0%, transparent 60%),
			#1a0102;
		background-size:
			96px 96px,
			96px 96px,
			24px 24px,
			24px 24px,
			auto,
			auto;
	}
	.qe-sec-h {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 0.95;
	}
	.qe-plan .qe-sec-h {
		font-size: clamp(2.5rem, 8vw, 7rem);
		color: #fff;
	}
	/* linha de cota sob o título */
	.qe-cota {
		position: relative;
		height: 13px;
		margin: 2rem 0 2.5rem;
	}
	.qe-cota::before {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		top: 6px;
		height: 1px;
		background: rgba(255, 206, 197, 0.5);
	}
	.qe-cota::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: 13px;
		border-left: 1px solid rgba(255, 206, 197, 0.5);
		border-right: 1px solid rgba(255, 206, 197, 0.5);
	}

	.qe-booths {
		list-style: none;
		margin: 0;
		padding: 14px;
		position: relative;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 14px;
		border: 2px solid rgba(255, 206, 197, 0.55);
	}
	/* marcas de corte nos 4 cantos da planta */
	.qe-booths::before,
	.qe-booths::after {
		content: "";
		position: absolute;
		width: 26px;
		height: 26px;
		border: 2px solid var(--color-blush);
		pointer-events: none;
	}
	.qe-booths::before {
		left: -9px;
		top: -9px;
		border-right: 0;
		border-bottom: 0;
	}
	.qe-booths::after {
		right: -9px;
		bottom: -9px;
		border-left: 0;
		border-top: 0;
	}
	.booth {
		grid-column: span var(--s);
		position: relative;
		min-height: 128px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 1rem 1.15rem 1.1rem;
		border: 1.5px solid rgba(255, 206, 197, 0.42);
		background: rgba(255, 255, 255, 0.035);
		transition:
			background-color 0.35s var(--ease-in-out),
			border-color 0.35s,
			transform 0.35s var(--ease-in-out);
	}
	.booth .bn {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.6875rem;
		letter-spacing: 0.12em;
		color: var(--color-blush);
		font-variant-numeric: tabular-nums;
	}
	.booth .bt {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.0625rem;
		line-height: 1.3;
		color: #fff;
		overflow-wrap: break-word;
		max-width: 30ch;
	}
	/* giro da porta do estande */
	.booth::after {
		content: "";
		position: absolute;
		right: 10px;
		top: 10px;
		width: 20px;
		height: 20px;
		border-top: 1.5px solid rgba(255, 206, 197, 0.4);
		border-right: 1.5px solid rgba(255, 206, 197, 0.4);
		border-top-right-radius: 100%;
	}
	.booth:hover {
		background: rgba(208, 45, 37, 0.26);
		border-color: #fff;
		transform: translateY(-3px);
	}

	/* ====================== QUEM VISITA — crachás ====================== */
	.qe-visit {
		position: relative;
		background: var(--color-rose-50);
		padding: 6.5rem 0 10rem;
	}
	.qe-visit .qe-sec-h {
		font-size: clamp(2.25rem, 7vw, 6rem);
		color: var(--color-primary);
	}
	.qe-badges {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 4rem 1.5rem;
		margin-top: 5rem;
	}
	.badge {
		--r: 0deg;
		position: relative;
		min-height: 288px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 2.6rem 1.15rem 2.1rem;
		background: #fff;
		border: 1px solid var(--color-line);
		border-radius: 14px;
		box-shadow: 0 22px 30px -24px rgba(73, 3, 6, 0.55);
		transform-origin: 50% -38px;
		transform: rotate(var(--r));
		transition:
			transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.4s;
	}
	.badge:nth-child(4n + 1) {
		--r: -1.3deg;
	}
	.badge:nth-child(4n + 2) {
		--r: 0.9deg;
	}
	.badge:nth-child(4n + 3) {
		--r: -0.7deg;
	}
	.badge:nth-child(4n + 4) {
		--r: 1.2deg;
	}
	/* cordão e furo do crachá */
	.badge::before {
		content: "";
		position: absolute;
		left: 50%;
		top: -38px;
		width: 3px;
		height: 57px;
		margin-left: -1.5px;
		border-radius: 2px;
		background: linear-gradient(#c7bab7, #8d817f);
	}
	.badge::after {
		content: "";
		position: absolute;
		left: 50%;
		top: 14px;
		width: 58px;
		height: 11px;
		margin-left: -29px;
		border-radius: 9999px;
		background: var(--color-rose-50);
		box-shadow: inset 0 2px 3px rgba(73, 3, 6, 0.4);
	}
	.badge .band {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 13px;
		border-radius: 0 0 13px 13px;
		background: linear-gradient(90deg, var(--color-primary-deep), var(--color-primary), var(--color-primary-bright));
	}
	.badge .wm {
		position: absolute;
		left: 14px;
		top: 12px;
		width: 18px;
		color: rgba(156, 12, 12, 0.4);
	} /* na faixa do furo, longe do texto */
	.badge .bt {
		position: relative;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.0625rem;
		line-height: 1.3;
		color: var(--color-primary);
		overflow-wrap: break-word;
		max-width: 100%;
	}
	.badge .bars {
		width: 56%;
		height: 15px;
		margin-top: 1.25rem;
		opacity: 0.3;
		background: repeating-linear-gradient(
			90deg,
			#393534 0 2px,
			transparent 2px 4px,
			#393534 4px 5px,
			transparent 5px 8px,
			#393534 8px 11px,
			transparent 11px 13px
		);
	}
	.badge:hover {
		transform: rotate(0deg) translateY(-5px);
		box-shadow: 0 34px 40px -26px rgba(73, 3, 6, 0.6);
	}

	/* ====================== CTA — pôster de largura total ====================== */
	.qe-cta {
		--cut: clamp(28px, 5vw, 88px);
		position: relative;
		z-index: 2;
		margin-top: calc(var(--cut) * -1);
		color: #fff;
		padding: calc(var(--cut) + 5rem) 0 6.5rem;
		clip-path: polygon(0 0, 100% var(--cut), 100% 100%, 0 100%);
		background:
			radial-gradient(70% 90% at 88% 12%, rgba(255, 206, 197, 0.24), transparent 60%),
			linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px), linear-gradient(115deg, #a81818 0%, #7a0a0c 42%, #3a0305 100%);
		background-size:
			auto,
			96px 96px,
			96px 96px,
			auto;
	}
	.cta-in {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.cta-h {
		margin: 0;
		font-family: var(--font-display);
		line-height: 1;
	}
	.cta-h span {
		display: block;
	}
	.cta-h .l1 {
		font-weight: 500;
		font-size: clamp(1.25rem, 2.7vw, 2.25rem);
		letter-spacing: 0.01em;
		color: var(--color-blush);
	}
	.cta-h .l2 {
		margin-top: 0.55rem;
		font-weight: 800;
		font-size: clamp(2.25rem, 6.2vw, 5.5rem);
		line-height: 0.98;
		letter-spacing: -0.03em;
		color: #fff;
		text-wrap: balance;
	}
	/* linha de cota sob a frase, como na planta */
	.cta-cota {
		position: relative;
		height: 13px;
		margin: 2.25rem 0 2.75rem;
		max-width: 560px;
	}
	.cta-cota::before {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		top: 6px;
		height: 1px;
		background: rgba(255, 206, 197, 0.7);
		transform-origin: left;
	}
	.cta-cota::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: 13px;
		border-left: 1px solid rgba(255, 206, 197, 0.7);
		border-right: 1px solid rgba(255, 206, 197, 0.7);
	}
	.cta-btn {
		display: inline-flex;
		align-items: center;
		gap: 1.1rem;
		padding: 0.95rem 0.95rem 0.95rem 2.3rem;
		border-radius: 9999px;
		border: 1px solid var(--color-blush);
		cursor: pointer;
		background: var(--color-blush);
		color: var(--color-primary);
		font-family: var(--font-display);
		font-size: 1.1875rem;
		font-weight: 800;
		letter-spacing: 0.01em;
		white-space: nowrap;
		text-decoration: none;
		box-shadow: 0 26px 40px -20px rgba(0, 0, 0, 0.65);
		transition:
			background-color 0.3s var(--ease-in-out),
			transform 0.1s;
	}
	.cta-btn:hover {
		background: #fff;
		border-color: #fff;
	}
	.cta-btn:active {
