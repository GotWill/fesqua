	/* ====================== ANIMAÇÃO DE ENTRADA (só existe quando o JS liga .qe-anim) ====================== */
	:global(.qe-anim) .booth {
		opacity: 0;
		transform: scale(0.94);
		transition:
			opacity 0.6s var(--ease-out) var(--d, 0s),
			transform 0.6s var(--ease-out) var(--d, 0s),
			background-color 0.35s,
			border-color 0.35s;
	}
	:global(.qe-anim) .booth.in {
		opacity: 1;
		transform: none;
	}
