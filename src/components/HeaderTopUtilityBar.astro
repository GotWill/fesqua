			height: 24px;
		}

		/* Sem espaço pros três ícones ao lado das duas marcas — some no
		   mobile mais estreito; hambúrguer continua abrindo o menu. */
		.social-nav {
			display: none;
		}

		.sidebar-inner {
			padding: 1.5rem 1.25rem 2.5rem;
		}

