173 25 -225 36 -52 11 -152 26 -221 34 -69 8 -171 24 -225 35 -54 11 -158 27 -230 35 -72 8 -173 23 -225 34 -52 11 -157 27 -234 36 -77 9 -180 25 -230 35 -49 10 -121 21 -160 25 -92 9 -250 33 -298 46 -21 6 -75 17 -120 25 -131 23 -120 -29 -117 541 10 1940 16 2423 26 2433 6 6 29 18 50 26 32 12 96 13 374 9 184 -3 720 -10 1190 -15z';
---

<svg
	class:list={['janela', className]}
	data-janela-draw
	viewBox="0 0 1290 1395"
	role="img"
	aria-label={label}
	style={style}
>
	<g transform="translate(0,1395) scale(0.1,-0.1)">
		<path class="p p-left" pathLength="1" d={BRACKET_LEFT} />
		<path class="p p-right" pathLength="1" d={BRACKET_RIGHT} />
		<path class="p p-window" pathLength="1" d={WINDOW} />
	</g>
</svg>

<style>
	.janela {
		display: block;
		height: auto;
		overflow: visible;
	}

	.janela .p {
		fill: var(--ink);
		fill-opacity: 0;
		stroke: var(--ink);
		stroke-width: 80;
		stroke-linejoin: round;
		stroke-linecap: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
	}

	.janela.play .p {
		animation: var(--cycle) cubic-bezier(0.65, 0, 0.35, 1) var(--delay, 0ms) infinite both;
	}

	.janela.play .p-left,
	.janela.play .p-right {
		animation-name: janela-contramarco;
	}

	.janela.play .p-window {
		animation-name: janela-vidro;
	}

	/* ciclo: desenha → segura contorno → preenche → segura → volta ao contorno → apaga */
	@keyframes janela-contramarco {
		0% {
			stroke-dashoffset: 1;
			fill-opacity: 0;
			stroke-opacity: 1;
		}
		30% {
			stroke-dashoffset: 0;
			fill-opacity: 0;
			stroke-opacity: 1;
		}
		41% {
			stroke-dashoffset: 0;
			fill-opacity: 0;
			stroke-opacity: 1;
		}
		53% {
			stroke-dashoffset: 0;
			fill-opacity: 1;
			stroke-opacity: 0;
		}
		78% {
			stroke-dashoffset: 0;
			fill-opacity: 1;
			stroke-opacity: 0;
		}
		88% {
			stroke-dashoffset: 0;
			fill-opacity: 0;
			stroke-opacity: 1;
		}
		100% {
			stroke-dashoffset: -1;
			fill-opacity: 0;
			stroke-opacity: 1;
		}
	}

	/* a janela começa 11% depois (≈0,55s numa volta de 5s),
	   mas preenche no mesmo instante que os colchetes */
	@keyframes janela-vidro {
		0% {
			stroke-dashoffset: 1;
			fill-opacity: 0;
			stroke-opacity: 1;
		}
		11% {
			stroke-dashoffset: 1;
			fill-opacity: 0;
			stroke-opacity: 1;
		}
		41% {
			stroke-dashoffset: 0;
			fill-opacity: 0;
			stroke-opacity: 1;
		}
		53% {
			stroke-dashoffset: 0;
			fill-opacity: 1;
			stroke-opacity: 0;
		}
		78% {
			stroke-dashoffset: 0;
			fill-opacity: 1;
			stroke-opacity: 0;
		}
		88% {
			stroke-dashoffset: 0;
			fill-opacity: 0;
			stroke-opacity: 1;
		}
		100% {
			stroke-dashoffset: -1;
			fill-opacity: 0;
			stroke-opacity: 1;
		}
	}

	/* pausa quando o ícone sai da tela */
	.janela.play.off .p {
		animation-play-state: paused;
	}

	@media (prefers-reduced-motion: reduce) {
		.janela .p {
			stroke-dashoffset: 0;
			fill-opacity: 1;
			stroke-opacity: 0;
		}
		.janela.play .p {
			animation: none;
		}
	}
</style>

<script>
	const icons = document.querySelectorAll<SVGSVGElement>('[data-janela-draw]');
	const io = new IntersectionObserver(
		(entries) => {
			entries.forEach((en) => {
				en.target.classList.add('play');
				en.target.classList.toggle('off', !en.isIntersecting);
			});
		},
		{ threshold: 0.2 },
	);
	icons.forEach((el) => io.observe(el));
</script>
