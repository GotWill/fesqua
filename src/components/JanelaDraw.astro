const WINDOW =
	'M10180 11664 c-41 -7 -137 -20 -215 -29 -77 -9 -187 -24 -245 -35 -58 -11 -157 -24 -220 -30 -63 -6 -171 -22 -240 -36 -69 -13 -177 -29 -240 -35 -63 -6 -176 -21 -250 -35 -74 -13 -198 -31 -275 -39 -77 -8 -175 -21 -217 -30 -43 -8 -155 -24 -250 -35 -95 -11 -218 -29 -273 -39 -55 -11 -134 -22 -175 -26 -103 -8 -207 -23 -321 -45 -53 -11 -147 -24 -210 -30 -63 -6 -176 -22 -251 -35 -75 -13 -185 -29 -245 -35 -59 -6 -171 -22 -248 -35 -77 -13 -174 -27 -215 -30 -41 -3 -154 -19 -250 -35 -96 -16 -225 -34 -286 -40 -62 -6 -168 -21 -235 -34 -68 -14 -178 -30 -244 -36 -66 -6 -151 -18 -190 -26 -38 -8 -160 -25 -270 -39 -110 -14 -234 -31 -276 -39 -41 -8 -124 -20 -185 -26 -60 -6 -176 -22 -259 -36 -82 -14 -209 -32 -282 -40 -72 -7 -191 -25 -265 -38 -73 -13 -182 -29 -243 -35 -60 -6 -155 -20 -210 -30 -55 -11 -152 -25 -215 -31 -63 -6 -180 -22 -260 -36 -80 -13 -209 -31 -287 -39 -153 -15 -203 -30 -226 -67 -17 -25 -17 -37 -37 -973 -5 -258 -14 -666 -20 -905 -5 -239 -14 -761 -20 -1160 -6 -399 -15 -891 -20 -1095 -6 -203 -15 -541 -20 -750 -6 -209 -11 -621 -13 -916 l-2 -537 31 -43 c20 -27 54 -56 92 -77 52 -28 78 -35 189 -48 70 -8 156 -21 190 -29 77 -18 162 -31 282 -45 52 -6 155 -21 230 -34 75 -13 181 -29 236 -36 55 -6 145 -20 199 -31 54 -10 147 -23 205 -29 58 -6 167 -22 241 -36 74 -13 195 -31 268 -39 74 -9 173 -24 220 -34 48 -11 149 -27 224 -35 75 -9 183 -25 240 -36 57 -10 150 -24 208 -30 58 -6 164 -22 235 -35 72 -13 176 -29 233 -34 57 -6 181 -24 275 -40 95 -16 206 -33 247 -36 41 -4 127 -17 190 -30 63 -13 144 -26 180 -30 83 -8 178 -22 310 -46 58 -10 152 -23 210 -29 58 -6 164 -21 235 -35 72 -13 180 -29 240 -35 61 -6 155 -20 210 -30 55 -11 174 -29 264 -40 91 -11 193 -27 228 -35 35 -8 123 -22 196 -30 73 -8 193 -26 267 -40 74 -13 169 -27 210 -30 41 -4 136 -17 210 -30 135 -24 233 -38 345 -50 33 -4 90 -13 126 -20 36 -8 139 -23 230 -35 90 -11 223 -31 294 -45 72 -13 162 -26 200 -30 39 -3 121 -15 184 -26 68 -12 129 -18 150 -14 87 16 162 77 195 158 11 25 15 203 20 872 10 1337 16 2005 27 2680 24 1609 29 2021 40 3345