---
// Ícone de janela do Grupo Contramarco, se desenhando em loop: traços
// nascem, preenchem, seguram, voltam ao contorno, se apagam e
// recomeçam. Paths copiados de public/images/janela-vetor.svg (versão
// vetorizada real — o janela.svg antigo é um PNG dentro de máscara,
// sem traço nenhum, e não dá pra animar assim).
interface Props {
	color?: string;
	size?: string;
	cycle?: number;
	delay?: number;
	label?: string;
	class?: string;
}

const { color = 'currentColor', size = '120px', cycle = 5000, delay = 0, label = 'Contramarco', class: className } = Astro.props;

// --delay (custom property, herda por toda a árvore de descendentes)
// em vez de um `animation-delay` literal no <svg>: essa propriedade
// não é herdada pelo CSS, e o <g> do transform ficaria entre o <svg>
// e os <path class="p">, cortando a herança antes de chegar neles.
const style = `--ink:${color};--cycle:${cycle}ms;--delay:${delay}ms;width:${size}`;

