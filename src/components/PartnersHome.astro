---
import fs from 'node:fs';
import path from 'node:path';
import JanelaDraw from './JanelaDraw.astro';
import { partnerGroups } from '../data/partners';

const LOGOS_DIR = path.resolve('public/images/logos');
const logoFiles = fs.readdirSync(LOGOS_DIR);

function resolveLogo(name: string): string {
	const match = logoFiles.find((f) => path.parse(f).name === name);
	if (!match) {
		throw new Error(`Logo "${name}" não encontrada em public/images/logos (arquivos disponíveis: ${logoFiles.join(', ')})`);
	}
	return `/images/logos/${match}`;
}
---

<!--
	Versão "sem abas" do PartnersSection: os mesmos grupos, na mesma ordem
	(src/data/partners.ts), todos visíveis de uma vez, separados por um
	cabeçalho com filete. Mesmo fundo, onda, marca d'água e tiles.
-->
<section class="partners-home on-primary" aria-labelledby="partners-home-title">
	<div class="wave" aria-hidden="true">
		<svg viewBox="0 0 1440 110" preserveAspectRatio="none">
			<path
				d="M0,0 L1440,0 L1440,26 C1200,70 1020,4 720,32 C420,60 240,8 0,46 Z"
				style="fill: var(--color-white)"
			/>
		</svg>
	</div>

	<div class="watermark watermark-tl" aria-hidden="true">
		<JanelaDraw color="var(--color-white)" size="100%" delay={1200} class="watermark-janela" />
	</div>
	<div class="watermark watermark-br" aria-hidden="true">
		<JanelaDraw color="var(--color-white)" size="100%" delay={2400} class="watermark-janela" />
	</div>

	<div class="partners-inner">
		<div class="partners-head">
			<span class="kicker">Quem torna a FESQUA possível</span>
			<h2 id="partners-home-title">
				Organização, apoio institucional e <em>parceiros de mídia</em> por trás de cada edição.
			</h2>
			<p>
				Instituições, veículos de imprensa e agências que ajudam a construir a experiência completa da
				feira — do credenciamento ao conteúdo técnico.
			</p>
		</div>

		<div class="groups">
			{
				partnerGroups.map((group) => (
					<section class="group reveal" data-group={group.id} aria-labelledby={`group-${group.id}`}>
						<header class="group-head">
							<h3 id={`group-${group.id}`}>{group.label}</h3>
							<span class="group-count" aria-label={`${group.partners.length} ${group.countLabel}`}>
								{group.partners.length}
							</span>
						</header>

						<ul class="ptile-grid">
							{group.partners.map((p) => (
								<li>
									{p.logo ? (
										<a
											class:list={['ptile', { featured: p.featured }]}
											href={p.url}
											target="_blank"
											rel="noopener"
											aria-label={p.name}
										>
											<img src={resolveLogo(p.logo)} alt={p.name} loading="lazy" />
										</a>
									) : (
										<a class="ptile text" href={p.url} target="_blank" rel="noopener">
											{p.name}
										</a>
									)}
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</div>
</section>

<style>
	.partners-home {
		position: relative;
		overflow: hidden;
		background: linear-gradient(175deg, var(--color-primary-deep) 0%, #360408 55%, var(--color-primary-deep) 100%);
		padding: 0 clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vw, 6rem);
	}

	/* Textura de pontos sutil, mais forte no topo, sumindo nas bordas. */
	.partners-home::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1.4px);
		background-size: 24px 24px;
		-webkit-mask-image: radial-gradient(ellipse 80% 65% at 50% 30%, #000 40%, transparent 85%);
		mask-image: radial-gradient(ellipse 80% 65% at 50% 30%, #000 40%, transparent 85%);
	}

	.watermark {
		position: absolute;
		z-index: 0;
		width: min(34%, 420px);
		aspect-ratio: 1 / 1;
		opacity: 0.4;
		transform: rotate(-8deg);
		pointer-events: none;
	}

	.watermark-tl {
		left: -6%;
		top: -11%;
	}

	.watermark-br {
		right: -6%;
		bottom: -11%;
	}

	.wave {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 110px;
		line-height: 0;
		z-index: 2;
	}

	.wave svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.partners-inner {
		position: relative;
		z-index: 1;
		max-width: 1280px;
		margin: 0 auto;
		padding-top: clamp(5rem, 10vw, 7rem);
	}

	.partners-head {
		max-width: 62ch;
		margin: 0 auto clamp(3rem, 6vw, 4.5rem);
		text-align: center;
	}

	.kicker {
		display: block;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.partners-head h2 {
		margin-top: 0.75rem;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 2.375rem;
		line-height: 1.3;
		color: var(--color-white);
	}

	.partners-head h2 em {
		font-style: normal;
		color: var(--color-blush);
	}

	.partners-head p {
		margin-top: 1rem;
		font-family: var(--font-body);
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--color-rose-300);
	}

	/* ---------- grupos empilhados ---------- */
	.groups {
		display: flex;
		flex-direction: column;
		gap: clamp(3.5rem, 7vw, 5.5rem);
	}

	/* entrada em fade, uma vez por grupo, quando ele entra na viewport */
	.reveal {
		opacity: 0;
		transform: translateY(22px);
		transition:
			opacity 0.7s var(--ease-out),
			transform 0.7s var(--ease-out);
	}

	.reveal.in {
		opacity: 1;
		transform: translateY(0);
	}

	/* Cabeçalho do grupo: filete — título + contagem — filete. Mesmo
	   vocabulário da pílula de abas (borda branca sutil, texto rose),
	   só que como divisor de seção em vez de controle. */
	.group-head {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
	}

	.group-head::before,
	.group-head::after {
		content: '';
		flex: 1 1 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.22));
	}

	.group-head::after {
		background: linear-gradient(270deg, transparent, rgba(255, 255, 255, 0.22));
	}

	.group-head h3 {
		flex: none;
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.875rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-align: center;
		color: var(--color-white);
	}

	.group-count {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.75rem;
		height: 1.5rem;
		padding: 0 0.5rem;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.16);
		font-family: var(--font-display);
		font-variant-numeric: tabular-nums;
		font-size: 0.6875rem;
		color: var(--color-rose-200);
	}

	/* ---------- tiles: só a logo, cor original, centralizada. Flex com
	   wrap (em vez de grid) pra a última linha ficar centralizada em vez
	   de grudar à esquerda — vale pros grupos pequenos (3 e 7 logos) e
	   pros grandes (16 e 30). ---------- */
	.ptile-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 1.125rem;
	}

	.ptile-grid li {
		flex: 0 0 170px;
		display: flex;
		justify-content: center;
	}

	/* Realização & Local: só 3 marcas, com destaque — sem largura fixa,
	   cada uma leva o tamanho do próprio tile. */
	.group[data-group='realizacao'] .ptile-grid li {
		flex: 0 1 auto;
	}

	.ptile {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 108px;
		padding: 0 1.5rem;
		text-decoration: none;
		border-radius: 0.5rem;
		transition: transform 0.25s var(--ease-out);
	}

	.ptile:hover {
		transform: translateY(-3px);
	}

	.ptile:focus-visible {
		outline: 2px solid var(--color-blush);
		outline-offset: 2px;
	}

	.ptile img {
		width: 100%;
		height: 64px;
		max-width: 200px;
		object-fit: contain;
	}

	.ptile.featured {
		height: 128px;
	}

	.ptile.featured img {
		height: 78px;
		max-width: 240px;
	}

	.ptile.text {
		font-family: var(--font-display);
		font-size: 0.75rem;
		font-weight: 500;
		text-align: center;
		color: var(--color-ink);
		background: rgba(255, 255, 255, 0.55);
		border: 1px dashed rgba(255, 255, 255, 0.6);
	}

	.ptile.text:hover {
		background: rgba(255, 255, 255, 0.75);
		color: var(--color-primary);
	}

	@media (max-width: 900px) {
		.watermark {
			width: 52%;
		}

		.watermark-tl {
			top: -8%;
		}

		.watermark-br {
			bottom: -8%;
		}

		.ptile-grid {
			gap: 1rem;
		}

		/* 3 por linha */
		.ptile-grid li {
			flex: 0 0 calc((100% - 2rem) / 3);
		}

		.group[data-group='realizacao'] .ptile-grid li {
			flex: 0 1 auto;
		}
	}

	@media (max-width: 560px) {
		.wave {
			height: 56px;
		}

		.partners-head {
			text-align: left;
		}

		.partners-head h2 {
			font-size: 1.875rem;
		}

		.group-head {
			gap: 0.75rem;
		}

		.group-head h3 {
			font-size: 0.75rem;
		}

		.ptile-grid {
			gap: 0.75rem;
		}

		/* 2 por linha */
		.ptile-grid li {
			flex: 0 0 calc((100% - 0.75rem) / 2);
		}

		.group[data-group='realizacao'] .ptile-grid li {
			flex: 0 1 auto;
		}

		.ptile {
			height: 72px;
			padding: 0 1rem;
		}

		.ptile img {
			height: 40px;
			max-width: 130px;
		}

		.ptile.featured {
			height: 88px;
		}

		.ptile.featured img {
			height: 52px;
			max-width: 160px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>

<script>
	const groups = document.querySelectorAll<HTMLElement>('.partners-home .reveal');
	if (groups.length) {
		const observer = new IntersectionObserver(
			(entries, obs) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('in');
					obs.unobserve(entry.target);
				});
			},
			{ threshold: 0.12 },
		);
		groups.forEach((el) => observer.observe(el));
	}
</script>
