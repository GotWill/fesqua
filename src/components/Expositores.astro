			}
		});
		dlg.addEventListener('click', (ev) => ev.target === dlg && closeModal());
		box.addEventListener('click', (ev) => ev.target.closest('[data-close]') && closeModal());
		grid.addEventListener('click', (ev) => {
			const b = ev.target.closest('[data-open]');
			if (b)
				openModal(
					data.find((x) => x.slug === b.dataset.open),
					b,
				);
		});
		const fromHash = () => {
			const h = decodeURIComponent(location.hash.slice(1));
			const e = h && data.find((x) => x.slug === h);
			if (e) openModal(e, null);
			else if (dlg.open) closeModal();
		};
		addEventListener('hashchange', fromHash);

		/* ---------- voltar ao topo ---------- */
		addEventListener('scroll', () => (topBtn.hidden = scrollY < 900), { passive: true });
		topBtn.addEventListener('click', () => scrollTo({ top: 0, behavior: RM ? 'auto' : 'smooth' }));

		finish();
		fromHash();
	}

	const initAll = () => document.querySelectorAll('[data-ex]').forEach(initExpositores);
	initAll();
	document.addEventListener('astro:page-load', initAll); // só dispara se o site usar View Transitions (<ClientRouter />)
</script>