			'<div class="md1-main"><div><h2 id="' +
			mid +
			'">' +
			esc(e.name) +
			'</h2>' +
			'<ul class="md1-seg">' +
			e.segments.map((s) => '<li>' + esc(s) + '</li>').join('') +
			'</ul>' +
			'<p class="md1-desc">' +
			esc(e.description) +
			'</p>' +
			'<h3>' +
			UI.highlights +
			'</h3><ul class="md1-prod">' +
			e.highlights.map((p) => '<li>' + esc(p) + '</li>').join('') +
			'</ul></div>' +
			'<dl class="md1-dl"><div><dt>' +
			UI.station +
			'</dt><dd>' +
			UI.street +
			' ' +
			e.street +
			' · ' +
			esc(e.booth) +
			'</dd></div>' +
			'<div><dt>' +
			UI.site +
			'</dt><dd><a href="https://' +
			esc(e.site) +
			'" target="_blank" rel="noopener">' +
			esc(e.site) +
			'</a></dd></div>' +
			'<div><dt>' +
			UI.mail +
			'</dt><dd><a href="mailto:' +
			esc(e.email) +
			'">' +
			esc(e.email) +
			'</a></dd></div>' +
			'<div><dt>' +
			UI.phone +
			'</dt><dd>' +
			esc(e.phone) +
			'</dd></div>' +
			'<div><dt>' +
			UI.since +
			'</dt><dd>' +
			e.since +
			'</dd></div></dl></div></div>';
		let lastTrigger = null;
		function openModal(e, trigger) {
			if (!e) return;
			lastTrigger = trigger || null;
			box.innerHTML = modalHTML(e);
			document.documentElement.classList.add('ex-no-scroll');
			dlg.classList.remove('is-closing');
			if (!dlg.open) dlg.showModal();
			dlg.scrollTop = 0;
			dlg.querySelector('[data-close]')?.focus({ preventScroll: true }); // sem isto o foco cai no contêiner rolável e aparece um anel em volta do modal
			history.replaceState(null, '', '#' + e.slug);
		}
		function closeModal() {
			if (!dlg.open || dlg.classList.contains('is-closing')) return;
			const done = () => {
				dlg.classList.remove('is-closing');
				dlg.close();
			};
			if (RM) return done();
			dlg.classList.add('is-closing');
			dlg.addEventListener('animationend', (ev) => ev.target === dlg && done(), { once: true });
		}
