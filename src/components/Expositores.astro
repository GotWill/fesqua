<script>
	const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const norm = (s) =>
		s
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.toLowerCase();
	const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
	const plural = (n, a, b) => n + ' ' + (n === 1 ? a : b);
	const initials = (name) =>
		name
			.split(/\s+/)
			.filter((w) => /^\p{L}/u.test(w) && w.length > 2)
			.slice(0, 2)
			.map((w) => w[0].toUpperCase())
			.join('') || name.slice(0, 2).toUpperCase();

	// textos da interface (vêm do servidor, já no idioma da página, pelo data-ui do componente)
	const readUI = (root) => {
		const u = JSON.parse(root.dataset.ui);
		return {
			one: u.one,
			result: u.result,
			none: u.none,
			noneLive: u.noneLive,
			forQuery: (q) => u.forQuery.replace('{q}', () => q),
			showing: (a, b) => u.showing.replace('{a}', () => a).replace('{b}', () => b),
			endCount: (n) => plural(n, u.one[0], u.one[1]),
			moreAbout: (n) => u.moreAbout.replace('{name}', () => n),
			station: u.station,
			street: u.street,
			highlights: u.highlights,
			site: u.site,
			mail: u.mail,
			phone: u.phone,
			since: u.since,
			close: u.close,
		};
	};

	// destaca o trecho encontrado no nome (ignorando acentos)
	function hl(name, q) {
		const nq = norm(q || '').trim();
		if (!nq) return esc(name);
		let n = '',
			map = [];
		for (let i = 0; i < name.length; i++)
			for (const ch of norm(name[i])) {
				n += ch;
				map.push(i);
			}
		const at = n.indexOf(nq);
		if (at < 0) return esc(name);
		const s = map[at],
			e = map[at + nq.length - 1] + 1;
		return esc(name.slice(0, s)) + '<mark>' + esc(name.slice(s, e)) + '</mark>' + esc(name.slice(e));
	}

	const SKELETON =
		'<li class="ex-sk" aria-hidden="true"><div class="xs"><div class="xs-logo"><i></i></div><div class="xs-body"><i style="width:40%;height:10px"></i><i style="width:72%;height:20px"></i><i style="width:55%;height:10px;margin-bottom:1.1rem"></i><i></i><i style="width:90%"></i><i style="width:60%"></i></div></div></li>';

	function initExpositores(root) {
		if (root.dataset.exReady) return;
		root.dataset.exReady = 'true';
		const UI = readUI(root);
		const q = (s) => root.querySelector(s);
		const data = JSON.parse(q('[data-ex-data]').textContent);
		data.forEach((e) => (e._n = norm(e.name)));
		const PAGE = +root.dataset.pageSize || 12;
		const grid = q('[data-ex-grid]'),
			sentinel = q('[data-ex-sentinel]'),
			countEl = q('[data-ex-count]'),
			live = q('[data-ex-live]'),
			qEl = q('[data-ex-q]'),
			endEl = q('[data-ex-end]'),
			emptyEl = q('[data-ex-empty]'),
			moreBtn = q('[data-ex-more]'),
			dlg = q('[data-ex-dlg]'),
			box = q('[data-ex-box]'),
			topBtn = q('[data-ex-top]');
		const proto = grid.querySelector('article')?.cloneNode(true); // modelo do cartão: o primeiro que o Astro já renderizou
		const S = { q: '', offset: grid.querySelectorAll('article').length, total: data.length, loading: false, token: 0, done: false };
		S.done = S.offset >= S.total;

		/* ---------- origem dos dados: troque por um fetch se vier de uma API (deve devolver { items, total }) ---------- */
		async function fetchPage(query, offset) {
			const nq = norm(query || '').trim();
			const list = nq ? data.filter((e) => e._n.includes(nq)) : data; // busca SOMENTE pelo nome
			return { items: list.slice(offset, offset + PAGE), total: list.length };
		}

		/* ---------- preenche um cartão clonado ---------- */
		function fill(node, e, query) {
			node.querySelector('[data-f=num]').textContent = e.booth;
			node.querySelector('[data-f=logo]').innerHTML = e.logoSvg
				? e.logoSvg
				: e.logo
					? '<img src="' + esc(e.logo) + '" alt="" loading="lazy" decoding="async">'
					: '<span class="xs-mono" aria-hidden="true">' + esc(initials(e.name)) + '</span>';
			node.querySelector('[data-f=street]').textContent = UI.street + ' ' + e.street;
			node.querySelector('[data-f=boothlabel]').textContent = UI.station + ' ' + e.booth;
			node.querySelector('[data-f=name]').innerHTML = hl(e.name, query);
			node.querySelector('[data-f=segments]').innerHTML = e.segments.map((s) => '<li>' + esc(s) + '</li>').join('');
