			fill(a, e, query);
			li.appendChild(a);
			return li;
		}

		/* ---------- contagem, estados e rolagem infinita ---------- */
		function setCount() {
			countEl.textContent = S.q
				? S.total === 0
					? UI.none
					: plural(S.total, UI.result[0], UI.result[1]) + UI.forQuery(S.q)
				: plural(S.total, UI.one[0], UI.one[1]);
		}
		async function load(reset) {
			if (reset) {
				S.token++;
				S.offset = 0;
				S.done = false;
				S.loading = false;
				grid.innerHTML = '';
				endEl.hidden = true;
				emptyEl.hidden = true;
			}
			if (S.loading || S.done || !proto) return;
			const token = S.token;
			S.loading = true;
			grid.setAttribute('aria-busy', 'true');
			const skTimer = setTimeout(() => grid.insertAdjacentHTML('beforeend', SKELETON.repeat(PAGE)), 120); // esqueletos só se demorar (API real)
			const r = await fetchPage(S.q, S.offset);
			clearTimeout(skTimer);
			if (token !== S.token) return; // a busca mudou enquanto carregava: descarta
			grid.querySelectorAll('.ex-sk').forEach((n) => n.remove());
			r.items.forEach((e, i) => grid.appendChild(cardLi(e, i, S.q)));
			S.total = r.total;
			S.offset += r.items.length;
			S.done = S.offset >= S.total;
			S.loading = false;
			grid.setAttribute('aria-busy', 'false');
			finish();
		}
		function finish() {
			setCount();
			emptyEl.hidden = S.total !== 0;
			emptyEl.querySelector('[data-ex-hint]').hidden = emptyEl.querySelector('[data-clear]').hidden = !S.q; // dica e botão só fazem sentido numa busca
			endEl.hidden = !(S.done && S.total > PAGE);
			if (S.done && S.total > 0) endEl.querySelector('b').textContent = UI.endCount(S.total);
