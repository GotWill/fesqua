		const mid = root.id + '-md-t';
		const modalHTML = (e) =>
			'<div class="md1"><button type="button" class="md1-x" data-close aria-label="' +
			UI.close +
			'"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"/></svg></button>' +
