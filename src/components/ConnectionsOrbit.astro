---
import fs from 'node:fs';
import path from 'node:path';

const LOGOS_DIR = path.resolve('public/images/logos');
const logoFiles = fs.readdirSync(LOGOS_DIR);

function resolveLogo(name: string): string {
	const match = logoFiles.find((f) => path.parse(f).name === name);
	if (!match) {
		throw new Error(
			`Logo "${name}" não encontrada em public/images/logos (arquivos disponíveis: ${logoFiles.join(', ')})`,
		);
	}
	return `/images/logos/${match}`;
}

interface Satellite {
	logo: string;
	label: string;
	x: number;
	y: number;
	labelPos: 'above' | 'below';
}

interface Stat {
	value: string;
	label: string;
}

interface Props {
	title?: string;
	tagline?: string;
	paragraphs?: string[];
	stat?: Stat;
	satellites?: Satellite[];
}

// 7 satélites (Ebrats removida), distribuídos em heptágono regular a
// partir do topo — passo de 360/7 ≈ 51.43°, raio único = 35 (mesmo
// valor de RING_RADII, cada satélite mora em cima do anel).
// Pra recalcular: x = 50 + r·cos(θ), y = 50 + r·sin(θ).
const DEFAULT_SATELLITES: Satellite[] = [
	{ logo: 'fesqua', label: 'Fesqua', x: 50.0, y: 15.0, labelPos: 'above' },
	{ logo: 'saie-vetro', label: 'Saie Vetro', x: 77.36, y: 28.18, labelPos: 'above' },
	{ logo: 'nelson-firmino', label: 'Nelson Firmino', x: 84.12, y: 57.79, labelPos: 'below' },
	{ logo: 'contramarco', label: 'Contramarco', x: 65.19, y: 81.54, labelPos: 'below' },
	{ logo: 'forum-contramarco', label: 'Fórum Contramarco', x: 34.81, y: 81.54, labelPos: 'below' },
	{ logo: 'feipat-v2', label: 'Feipat', x: 15.88, y: 57.79, labelPos: 'below' },
	{ logo: 'fesqua-vetro-v2', label: 'Fesqua Vetro', x: 22.64, y: 28.18, labelPos: 'above' },
];

// 35 coincide de propósito com o raio dos satélites — cada
// satélite "mora" exatamente em cima do anel do meio.
const RING_RADII = [16, 21, 26, 30, 35, 41, 46];

const {
	title = 'Grupo Contramarco',
	tagline = 'Nós conectamos a indústria de esquadrias e vidro',
	paragraphs = [
		'O <strong>Grupo Contramarco</strong> reúne feiras, publicações e iniciativas que já fazem parte do dia a dia de quem trabalha com esquadrias, vidro e construção civil.',
		'Cada marca opera de forma independente, mas compartilha a mesma rede de contatos, conhecimento técnico e presença consolidada no setor.',
		'Juntas, formam um ecossistema que conecta fabricantes, fornecedores, arquitetos e profissionais em <strong>todo o Brasil</strong>.',
	],
	stat = { value: '7', label: 'marcas conectadas em um só ecossistema' },
	satellites = DEFAULT_SATELLITES,
}: Props = Astro.props;
---

<section class="event">
	<div class="event-inner">
		<div class="event-text">
			<span class="kicker">Um evento</span>

			<div class="lockup">
				<img src={resolveLogo('lockup')} alt={`${title} — ${tagline}`} />
			</div>

			<div class="event-copy">
				{paragraphs.map((p) => <p set:html={p} />)}
			</div>
		</div>

		<div class="event-visual">
			<div class="orbit" id="orbit" aria-label={`Marcas conectadas ao ${title}`}>
				<svg class="orbit-rings" viewBox="0 0 100 100" aria-hidden="true">
					{RING_RADII.map((r) => (
						<circle cx="50" cy="50" r={r} />
					))}

					<g class="comet">
						<circle class="comet-dot" cx="78.19" cy="60.26" r="1" />
						<circle class="comet-dot" cx="79.23" cy="56.75" r="0.85" opacity="0.78" />
						<circle class="comet-dot" cx="79.84" cy="53.14" r="0.7" opacity="0.56" />
						<circle class="comet-dot" cx="80.00" cy="49.48" r="0.55" opacity="0.34" />
						<circle class="comet-dot" cx="79.71" cy="45.82" r="0.4" opacity="0.12" />
						<animateTransform
							attributeName="transform"
							type="rotate"
							from="0 50 50"
							to="360 50 50"
							dur="26s"
							repeatCount="indefinite"
						/>
					</g>
					<g class="comet">
						<circle class="comet-dot alt" cx="11.47" cy="35.98" r="1" />
						<circle class="comet-dot alt" cx="10.05" cy="40.78" r="0.85" opacity="0.78" />
						<circle class="comet-dot alt" cx="9.22" cy="45.71" r="0.7" opacity="0.56" />
						<circle class="comet-dot alt" cx="9.01" cy="50.72" r="0.55" opacity="0.34" />
						<circle class="comet-dot alt" cx="9.40" cy="55.71" r="0.4" opacity="0.12" />
						<animateTransform
							attributeName="transform"
							type="rotate"
							from="0 50 50"
							to="-360 50 50"
							dur="33s"
							repeatCount="indefinite"
						/>
					</g>
				</svg>

				<div class="hub">
					<img src={resolveLogo('hub-icon')} alt={title} />
				</div>

				<div class="stat-chip">
					<span class="stat-dot" aria-hidden="true"></span>
					<strong class="stat-value">{stat.value}</strong>
					<span class="stat-label">{stat.label}</span>
				</div>

				{
					satellites.map((s, i) => (
						<div class="satellite" data-label={s.labelPos} style={`--x:${s.x}%;--y:${s.y}%;--i:${i}`}>
							<div class="badge">
								<img src={resolveLogo(s.logo)} alt={s.label} loading="lazy" />
							</div>
							<span class="label">{s.label}</span>
						</div>
					))
				}
			</div>

			<p class="visual-caption">{tagline}</p>
		</div>
	</div>
</section>

<style>
	.event {
		position: relative;
		background: var(--color-surface-alt);
		padding: clamp(4rem, 8vw, 6rem) clamp(1.5rem, 5vw, 4rem);
	}

	.event-inner {
		max-width: 1280px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(2.5rem, 6vw, 5rem);
	}

	.kicker {
		display: block;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.lockup {
		margin-top: 1rem;
	}

	.lockup img {
		height: 2.75rem;
		width: auto;
	}

	.event-copy {
		margin-top: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.event-copy p {
		font-family: var(--font-body);
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--color-ink);
	}

	.event-copy :global(strong) {
		font-weight: 400;
		color: var(--color-text);
	}

	/* ---------- diagrama de órbita ---------- */
	.event-visual {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.orbit {
		position: relative;
		width: 100%;
		max-width: 480px;
		aspect-ratio: 1 / 1;
		opacity: 0;
		transform: scale(0.92);
		transition:
			opacity 0.6s var(--ease-out),
			transform 0.6s var(--ease-out);
	}

	.orbit.in {
		opacity: 1;
		transform: scale(1);
	}

	.orbit-rings {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.orbit-rings circle {
		fill: none;
		stroke: var(--color-red-100);
		stroke-width: 0.4;
	}

	.comet-dot {
		fill: var(--color-primary-bright);
	}

	.comet-dot.alt {
		fill: var(--color-primary-bright);
	}

	/* ---------- hub central ---------- */
	.hub {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 29%;
		aspect-ratio: 1 / 1;
		transform: translate(-50%, -50%);
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background: var(--color-primary);
		box-shadow: 0 18px 34px rgba(73, 3, 6, 0.28);
	}

	.hub img {
		width: 52%;
		height: 52%;
		object-fit: contain;
	}

	.hub::before {
		content: '';
		position: absolute;
		inset: -8%;
		border: 1px solid var(--color-primary-bright);
		border-radius: 9999px;
		animation: hub-pulse 2.8s ease-out infinite;
	}

	@keyframes hub-pulse {
		from {
			transform: scale(0.86);
			opacity: 1;
		}
		to {
			transform: scale(1.22);
			opacity: 0;
		}
	}

	/* ---------- selo de estatística: canto vazio do quadrado, fora dos
	   anéis — nunca em cima de um múltiplo de 45° (colide com o
	   satélite Contramarco). ---------- */
	.stat-chip {
		position: absolute;
		right: -3%;
		bottom: -1%;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.625rem 0.875rem;
		border-radius: 0.875rem;
		background: var(--color-white);
		box-shadow: 0 14px 28px rgba(73, 3, 6, 0.14);
	}

	.stat-dot {
		flex: none;
		width: 8px;
		height: 8px;
		border-radius: 9999px;
		background: var(--color-primary-bright);
	}

	.stat-value {
		font-family: var(--font-display);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		font-size: 1.375rem;
		line-height: 1;
		color: var(--color-primary);
	}

	.stat-label {
		max-width: 6.5rem;
		font-family: var(--font-body);
		font-size: 0.6875rem;
		line-height: 1.3;
		color: var(--color-ink);
	}

	/* ---------- satélites: tudo em %, herdado do aspect-ratio:1/1 do
	   .orbit — é assim que o diagrama inteiro escala sem JS. ---------- */
	.satellite {
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: 15%;
		aspect-ratio: 1 / 1;
		z-index: 1;
		transform: translate(-50%, -50%) scale(0.5);
		opacity: 0;
		transition:
			transform 0.5s var(--ease-out),
			opacity 0.5s var(--ease-out);
		transition-delay: calc(var(--i) * 90ms + 0.15s);
	}

	.orbit.in .satellite {
		transform: translate(-50%, -50%) scale(1);
		opacity: 1;
	}

	.badge {
		display: flex;
		width: 100%;
		height: 100%;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		overflow: hidden;
		background: #fff;
		border: 1px solid var(--color-red-100);
		box-shadow: 0 8px 16px rgba(73, 3, 6, 0.14);
		transition:
			transform 0.25s var(--ease-out),
			box-shadow 0.25s var(--ease-out);
	}

	/* A caixa da imagem não pode crescer livremente: o badge é um
	   círculo com overflow:hidden, e uma caixa grande estoura o
	   círculo pelos cantos antes de estourar pelos lados —
	   √((76/2)²+(52/2)²) ≈ 46, bem abaixo dos 50 (raio, em %). */
	.badge img {
		width: 76%;
		height: 52%;
		object-fit: contain;
	}

	.satellite:hover .badge {
		transform: translateY(-3px);
		box-shadow: 0 16px 26px rgba(73, 3, 6, 0.22);
	}

	.label {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		max-width: 7.6rem;
		text-align: center;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(0.5rem, 1.6vw, 0.625rem);
		line-height: 1.25;
		letter-spacing: 0.01em;
		text-transform: uppercase;
		color: var(--color-ink);
	}

	.satellite[data-label='above'] .label {
		bottom: 100%;
		margin-bottom: 0.35rem;
	}

	.satellite[data-label='below'] .label {
		top: 100%;
		margin-top: 0.35rem;
	}

	.visual-caption {
		margin-top: 1.5rem;
		font-family: var(--font-body);
		font-size: 0.9375rem;
		color: var(--color-ink);
		text-align: center;
	}

	@media (max-width: 980px) {
		.event-inner {
			grid-template-columns: 1fr;
			gap: 5.5rem;
		}

		.orbit {
			max-width: 400px;
		}
	}

	@media (max-width: 460px) {
		.orbit {
			max-width: 320px;
		}

		.stat-chip {
			padding: 0.5rem 0.625rem;
			gap: 0.375rem;
		}

		.stat-label {
			max-width: 5rem;
		}
	}
</style>

<script>
	const orbit = document.getElementById('orbit');
	if (orbit) {
		const observer = new IntersectionObserver(
			(entries, obs) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					orbit.classList.add('in');
					obs.disconnect();
				});
			},
			{ threshold: 0.35 },
		);
		observer.observe(orbit);
	}

	if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelectorAll('animateTransform').forEach((el) => el.remove());
	}
</script>
