---
import { getLang, pick, route } from '../i18n/utils';
import { chrome, navTree } from '../i18n/content/chrome';

interface NavChild {
	label: string;
	href: string;
}

interface NavItem {
	id: string;
	label: string;
	href: string;
	dropdown?: boolean;
	children?: NavChild[];
}

const lang = getLang(Astro.currentLocale);
const c = pick(chrome, lang);

// Estrutura pronta para receber novos links: itens com `dropdown: true` e
// `children: []` já têm a seta e o acordeão funcionando, só falta popular.
const nav: NavItem[] = navTree.map((n) => ({
	id: n.id,
	label: c.labels[n.id as keyof typeof c.labels],
	href: route(lang, n.route),
	dropdown: !!n.children,
	children: n.children?.map((ch) => ({
		label: c.labels[ch.id as keyof typeof c.labels],
		href: 'href' in ch ? ch.href : route(lang, ch.route),
	})),
}));

// Atalhos da barra principal — derivados do array `nav` acima, sem
// duplicar hrefs.
const shortcuts = nav.filter((i) =>
	['expositor', 'visitante', 'programacao', 'imprensa'].includes(i.id),
);

// Marca o link da página atual (aria-current) — também é gancho de CSS.
const normPath = (p: string) => p.replace(/\/+$/, '') || '/';
const currentPath = normPath(Astro.url.pathname);
const isCurrent = (href: string) => (normPath(href) === currentPath ? "page" : undefined);
---

<header class="site-header on-primary" id="site-header">
	<!-- barra superior -->
	<div class="topbar">
		<div class="tb-inner" id="tb-inner">
			<div
				class="tb-item countdown"
				id="countdown"
				data-state="before"
				data-sr-before={c.cdSrBefore}
				data-chip-days={c.cdChipDays}
				data-live={c.cdLive}
				data-after={c.cdAfter}
				data-chip-live={c.cdChipLive}
				data-chip-after={c.cdChipAfter}
			>
				<span class="cd-dot" aria-hidden="true"></span>
				<span class="cd-label">{c.cdLabel}</span>
				<span class="cd-units" aria-hidden="true">
					<span class="cd-unit"><span class="cd-num" data-cd="d">000</span><span class="cd-u">{c.cdDays}</span></span>
					<span class="cd-unit"><span class="cd-num" data-cd="h">00</span><span class="cd-u">{c.cdHours}</span></span>
					<span class="cd-unit"><span class="cd-num" data-cd="m">00</span><span class="cd-u">{c.cdMin}</span></span>
					<span class="cd-unit"><span class="cd-num" data-cd="s">00</span><span class="cd-u">{c.cdSec}</span></span>
				</span>
				<span class="cd-msg" id="cd-msg"></span>
				<span class="sr-only" id="cd-sr"></span>
			</div>

			<span class="tb-sep" aria-hidden="true"></span>
			<div class="tb-item tb-meta tb-date">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
					<rect x="3" y="5" width="18" height="16" rx="2"></rect>
					<path d="M3 9h18M8 3v4M16 3v4" stroke-linecap="round"></path>
				</svg>
				{c.dateFull} <span class="muted dur">{c.duration}</span>
			</div>

			<span class="tb-sep" aria-hidden="true"></span>
			<a
				class="tb-item tb-meta tb-venue"
				href="https://www.google.com/maps/search/?api=1&query=S%C3%A3o+Paulo+Expo"
				target="_blank"
				rel="noopener"
				title={c.venueTitle}
			>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
					<path d="M12 21s7-6.5 7-11a7 7 0 1 0-14 0c0 4.5 7 11 7 11Z" stroke-linejoin="round"></path>
					<circle cx="12" cy="10" r="2.25"></circle>
				</svg>
				São Paulo Expo
				<span class="muted addr addr-full">{c.addrFull}</span>
				<span class="muted addr addr-mid">{c.addrMid}</span>
				<span class="muted addr addr-short">{c.addrShort}</span>
			</a>

			<div class="tb-item mb-sim">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
					<path d="M12 3 3 8l9 5 9-5-9-5Z" stroke-linejoin="round"></path>
					<path d="M3 12l9 5 9-5M3 16l9 5 9-5" stroke-linejoin="round"></path>
				</svg>
				<span class="sim-label">{c.simultaneous}</span>
				<img class="sim-logo" src="/images/logos/feipat.webp" alt="Feipat" />
			</div>

			<nav class="socials" aria-label={c.socialLabel}>
				<a href="https://www.instagram.com/fesqua/" target="_blank" rel="noopener" aria-label="Instagram">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<rect x="3" y="3" width="18" height="18" rx="5"></rect>
						<circle cx="12" cy="12" r="4"></circle>
						<circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"></circle>
					</svg>
				</a>
				<a href="https://www.facebook.com/fesqua" target="_blank" rel="noopener" aria-label="Facebook">
					<svg viewBox="0 0 24 24" fill="currentColor">
						<path d="M14 8.5V7c0-.8.5-1 1-1h2V2.5h-3c-3 0-4 2-4 4.3v1.7H7.5V12H10v9.5h4V12h2.7l.5-3.5z"></path>
					</svg>
				</a>
				<a
					href="http://linkedin.com/in/fesqua-feira-internacional-da-ind%C3%BAstria-de-esquadrias-2aa94725a"
					target="_blank"
					rel="noopener"
					aria-label="LinkedIn"
				>
					<svg viewBox="0 0 24 24" fill="currentColor">
						<path
							d="M4.5 8.5h3.5V20H4.5zM6.2 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM10 8.5h3.4v1.6c.5-.9 1.7-1.9 3.5-1.9 3.7 0 4.3 2.4 4.3 5.5V20h-3.5v-5.6c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3V20H10z"
						></path>
					</svg>
				</a>
			</nav>
		</div>
	</div>

	<!-- barra principal -->
	<div class="mainbar">
		<div class="mb-inner">
			<a href={route(lang, 'home')} class="brand">
				<img src="/images/logo-fesqua-white.png" alt="Fesqua" />
				<span class="brand-divider" aria-hidden="true"></span>
				<img src="/images/logo-fesqua-vetro-white.png" alt="Fesqua Vetro" />
			</a>

			<div class="mb-center">
				<nav class="main-nav" aria-label={c.shortcutsLabel}>
					{shortcuts.map((item) =>
						item.dropdown && item.children?.length ? (
							<div class="nav-item">
								<a href={item.href} class="nav-link">
									{item.label}
									<svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
										<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</a>
								<div class="nav-dropdown">
									<div class="nav-dropdown-panel">
										<ul>
											{item.children.map((child) => (
												<li>
													<a href={child.href} aria-current={isCurrent(child.href)}>{child.label}</a>
												</li>
											))}
										</ul>
									</div>
								</div>
							</div>
						) : (
							<a href={item.href} class="nav-link">
								{item.label}
							</a>
						),
					)}
				</nav>
			</div>

			<div class="mb-actions">
				<span class="cd-chip" aria-hidden="true">
					<span class="cd-dot"></span>
					<span class="chip-full"><span data-chip="d">000</span>d <small>·</small> <span data-chip="t">00:00:00</span></span>
					<span class="chip-short" data-chip="short">{c.cdChipDays.replace("{d}", "000")}</span>
				</span>

				<div class="header-ctas">
					<a href={route(lang, 'queroExpor')} class="btn Outline_White btn-sm">
						<div class="slime">
							<span></span><span></span><span></span>
						</div>
						<div class="btn-content"><span>{c.ctaExhibit}</span></div>
					</a>
					<a href={route(lang, 'queroVisitar')} class="btn Solid_Blush btn-sm">
						<div class="slime">
							<span></span><span></span><span></span>
						</div>
						<div class="btn-content"><span>{c.ctaVisit}</span></div>
					</a>
				</div>

				<button
					class="hamburger_menu_wrapper"
					id="menu-toggle"
					type="button"
					aria-label={c.menuOpen}
					aria-expanded="false"
					aria-controls="site-sidebar"
				>
					<span class="menu-label">{c.menuLabel}</span>
					<div class="not-active">
						<span></span><span></span><span></span>
					</div>
				</button>
			</div>
		</div>
	</div>
</header>

<div class="sidebar-overlay" id="sidebar-overlay" hidden></div>

<aside
	class="sidebar"
	id="site-sidebar"
	aria-hidden="true"
	aria-label={c.sidebarLabel}
>
	<div class="sidebar-inner">
		<div class="sidebar-top">
			<span class="kicker">{c.menuLabel}</span>
			<button
				class="sidebar-close"
				id="sidebar-close"
				type="button"
				aria-label={c.menuClose}
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					aria-hidden="true"
				>
					<path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"
					></path>
				</svg>
			</button>
		</div>

		<div class="sidebar-grid">
			<div class="sidebar-info">
				<div class="info-block">
					<span class="kicker">{c.when}</span>
					<div class="info-date">
						<strong>{c.dayRange}</strong><span class="info-month">{c.monthYear}</span>
					</div>
					<div class="info-duration">
						<span class="dash" aria-hidden="true"></span>{c.durationDays}
					</div>
					<p class="info-hours">{c.hoursWeek}<br />{c.hoursSat}</p>
				</div>

				<div class="info-block">
					<span class="kicker">{c.where}</span>
					<p class="info-venue">São Paulo Expo</p>
					<p class="info-address">{c.address}</p>
				</div>

				<div class="info-block">
					<span class="kicker">{c.simultaneous}</span>
					<div class="info-logos">
						<span class="logo-chip"
							><img
								src="/images/logos/feipat.webp"
								alt="Feipat"
							/></span
						>
					</div>
				</div>
			</div>

			<nav class="sidebar-nav">
				<ul>
					{
						nav.map((item, i) => (
							<li
								class:list={[{ "has-dropdown": item.dropdown }]}
							>
								{item.dropdown ? (
									<button
										class="nav-row dropdown-toggle"
										type="button"
										aria-expanded="false"
										aria-controls={`sidebar-drop-${i}`}
									>
										<span>{item.label}</span>
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											aria-hidden="true"
										>
											<path
												d="M6 9l6 6 6-6"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
									</button>
								) : (
									<div class="nav-row">
										<a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a>
									</div>
								)}

								{item.dropdown && (
									<ul
										class="dropdown"
										id={`sidebar-drop-${i}`}
									>
										{item.children?.map((child) => (
											<li>
												<a href={child.href} aria-current={isCurrent(child.href)}>
													{child.label}
												</a>
											</li>
										))}
									</ul>
								)}
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>
</aside>

<style>
	.site-header {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 4000;
		color: var(--color-white);
		transition: transform 0.45s var(--ease-in-out);
	}

	/* ao rolar, o header inteiro sobe exatamente a altura da barra superior */
	.site-header.is-compact {
		transform: translateY(calc(-1 * var(--topbar-h)));
	}

	/* ---------- barra superior ---------- */
	.topbar {
		height: var(--topbar-h);
		background: var(--color-primary-deep);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.tb-inner {
		height: 100%;
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0 clamp(1.25rem, 4vw, 3rem);
	}

	.tb-sep {
		width: 1px;
		height: 22px;
		background: rgba(255, 255, 255, 0.18);
		flex: none;
	}

	.tb-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		white-space: nowrap;
		color: var(--color-white);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.9375rem;
		letter-spacing: 0.01em;
	}

	a.tb-meta {
		text-decoration: none;
		transition: color 0.25s var(--ease-in-out);
	}

	a.tb-meta:hover {
		color: var(--color-blush);
	}

	.tb-meta svg {
		width: 19px;
		height: 19px;
		color: var(--color-blush);
		flex: none;
	}

	.tb-meta .muted,
	.sim-label {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 0.875rem;
		color: var(--color-rose-200);
		letter-spacing: 0;
	}

	.addr-mid,
	.addr-short {
		display: none;
	}

	.sim-logo {
		height: 26px;
		width: auto;
		display: block;
	}

	.socials {
		display: flex;
		gap: 0.4rem;
		flex: none;
	}

	.socials a {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-rose-200);
		border: 1px solid rgba(255, 255, 255, 0.18);
		transition:
			color 0.25s var(--ease-in-out),
			border-color 0.25s var(--ease-in-out),
			background 0.25s var(--ease-in-out);
	}

	.socials a:hover {
		color: var(--color-primary);
		background: var(--color-blush);
		border-color: var(--color-blush);
	}

	.socials svg {
		width: 14px;
		height: 14px;
	}

	/* ---------- contagem regressiva (blocos de placar) ---------- */
	.countdown {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		white-space: nowrap;
	}

	.cd-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-blush);
		flex: none;
		position: relative;
	}

	.cd-dot::after {
		content: "";
		position: absolute;
		inset: -4px;
		border-radius: 50%;
		border: 1px solid var(--color-blush);
		animation: cd-pulse 2s var(--ease-out) infinite;
	}

	@keyframes cd-pulse {
		0% {
			transform: scale(0.5);
			opacity: 0.9;
		}
		100% {
			transform: scale(1.6);
			opacity: 0;
		}
	}

	.cd-label {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.8125rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-blush);
	}

	.cd-units {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.cd-unit {
		display: flex;
		align-items: baseline;
		gap: 0.25rem;
		padding: 0.28rem 0.55rem;
		border-radius: 6px;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.09);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.cd-num {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.1875rem;
		line-height: 1;
		color: #fff;
		font-variant-numeric: tabular-nums;
		display: inline-block;
	}

	.cd-u {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-rose-300);
	}

	/* só o número que mudou anima — o overflow:hidden do bloco dá o
	   efeito de placar */
	.cd-num.tick {
		animation: cd-tick 0.45s var(--ease-out);
	}

	@keyframes cd-tick {
		from {
			transform: translateY(-35%);
			opacity: 0;
		}
		to {
			transform: none;
			opacity: 1;
		}
	}

	.cd-msg {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.9375rem;
		color: #fff;
		display: none;
	}

	.countdown[data-state="live"] :is(.cd-units, .cd-label),
	.countdown[data-state="after"] :is(.cd-units, .cd-label) {
		display: none;
	}

	.countdown[data-state="live"] .cd-msg,
	.countdown[data-state="after"] .cd-msg {
		display: inline;
	}

	.countdown[data-state="live"] .cd-dot {
		background: #3ddc84;
	}

	.countdown[data-state="live"] .cd-dot::after {
		border-color: #3ddc84;
	}

	.countdown[data-state="after"] .cd-dot {
		background: var(--color-rose-300);
	}

	.countdown[data-state="after"] .cd-dot::after {
		display: none;
	}

	/* ---------- barra principal ---------- */
	.mainbar {
		height: var(--main-h);
		background: linear-gradient(115deg, var(--color-primary-deep), var(--color-primary));
		transition:
			height 0.45s var(--ease-in-out),
			box-shadow 0.45s var(--ease-in-out);
	}

	.site-header.is-compact .mainbar {
		height: var(--main-h-compact);
		box-shadow: 0 10px 30px -12px rgba(31, 3, 4, 0.55);
	}

	.mb-inner {
		height: 100%;
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 0 clamp(1.25rem, 4vw, 3rem);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex: none;
	}

	.brand img {
		height: 56px;
		width: auto;
		transition: height 0.45s var(--ease-in-out);
	}

	.site-header.is-compact .brand img {
		height: 44px;
	}

	.brand-divider {
		width: 1px;
		height: 32px;
		background: rgba(255, 255, 255, 0.3);
		flex: none;
	}

	/* ---------- centro da barra principal: eventos simultâneos + atalhos,
	   centralizados como um único grupo no espaço entre a marca e as
	   ações (não é o centro exato da barra se marca/ações tiverem
	   larguras diferentes — é centralizado no espaço livre entre elas,
	   o padrão usual de header). ---------- */
	.mb-center {
		flex: 1 1 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
		min-width: 0;
	}

	.mb-sim {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		white-space: nowrap;
		flex: none;
		/* centraliza no espaço livre entre o local e as redes sociais */
		margin: 0 auto;
	}

	.mb-sim svg {
		width: 18px;
		height: 18px;
		color: var(--color-blush);
		flex: none;
	}

	.main-nav {
		display: flex;
		align-items: center;
		gap: 1.75rem;
	}

	.nav-item {
		position: relative;
	}

	.nav-link {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.3rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.875rem;
		color: var(--color-rose-200);
		padding: 0.4rem 0;
		text-decoration: none;
		transition: color 0.25s var(--ease-in-out);
	}

	.nav-link::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 1.5px;
		background: var(--color-blush);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s var(--ease-in-out);
	}

	.nav-link:hover,
	.nav-item:focus-within .nav-link {
		color: #fff;
	}

	.nav-link:hover::after,
	.nav-item:focus-within .nav-link::after {
		transform: scaleX(1);
	}

	.nav-chevron {
		width: 13px;
		height: 13px;
		flex: none;
		color: var(--color-rose-300);
		transition:
			transform 0.25s var(--ease-in-out),
			color 0.25s var(--ease-in-out);
	}

	.nav-item:hover .nav-chevron,
	.nav-item:focus-within .nav-chevron {
		transform: rotate(180deg);
		color: var(--color-blush);
	}

	/* ---------- dropdown do atalho: mesma estrutura de dados da
	   sidebar (item.children), mas como painel de vidro sob hover/foco
	   em vez do acordeão vertical — o padrão certo pra um menu
	   horizontal. .nav-dropdown é a "ponte" invisível (zero gap real
	   até o link, o respiro visual vem do padding-top) que mantém o
	   :hover ativo enquanto o mouse desce até o painel; sem ela, o
	   gap fecha o menu antes de chegar lá. ---------- */
	.nav-dropdown {
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		padding-top: 0.75rem;
		min-width: 240px;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 0.25s var(--ease-out),
			visibility 0s 0.25s;
		z-index: 10;
	}

	.nav-item:hover .nav-dropdown,
	.nav-item:focus-within .nav-dropdown {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transition:
			opacity 0.25s var(--ease-out),
			visibility 0s;
	}

	.nav-dropdown-panel {
		padding: 0.5rem;
		border-radius: 0.875rem;
		/* Sólido, sem backdrop-filter — mesmo ajuste feito na sidebar
		   (ver .sidebar): o blur falha em produção em parte dos
		   navegadores/dispositivos (alguns Chrome Android), deixando o
		   painel transparente e ilegível sobre o hero. Gradiente sólido
		   não depende de suporte a nada. */
		background: linear-gradient(160deg, #2a0406 0%, #180203 60%, #120102 100%);
		border: 1px solid rgba(255, 255, 255, 0.14);
		box-shadow: 0 20px 40px rgba(31, 3, 4, 0.4);
	}

	.nav-dropdown ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.nav-dropdown li a {
		display: block;
		padding: 0.6rem 0.75rem;
		border-radius: 0.5rem;
		font-family: var(--font-body);
		font-size: 0.875rem;
		white-space: nowrap;
		color: var(--color-rose-200);
		text-decoration: none;
		transition:
			background-color 0.2s var(--ease-in-out),
			color 0.2s var(--ease-in-out);
	}

	.nav-dropdown li a:hover,
	.nav-dropdown li a:focus-visible {
		background: rgba(255, 255, 255, 0.08);
		color: var(--color-white);
	}

	/* ---------- ações da barra principal: selo + CTAs + hambúrguer ---------- */
	.mb-actions {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	/* selo compacto: aparece quando a barra superior some */
	.cd-chip {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.8rem;
		border-radius: 9999px;
		border: 1px solid rgba(255, 255, 255, 0.2);
		background: rgba(0, 0, 0, 0.14);
		white-space: nowrap;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		opacity: 0;
		transform: translateY(-6px);
		pointer-events: none;
		transition:
			opacity 0.35s var(--ease-out),
			transform 0.35s var(--ease-out);
	}

	.cd-chip .cd-dot {
		width: 6px;
		height: 6px;
	}

	.cd-chip small {
		font-weight: 500;
		color: var(--color-rose-300);
		font-size: 0.6875rem;
	}

	.site-header.is-compact .cd-chip {
		opacity: 1;
		transform: none;
		pointer-events: auto;
	}

	.chip-short {
		display: none;
	}

	/* ---------- CTAs de destaque na barra principal (mesmos botões
	   "Quero Expor" / "Quero Visitar" da hero) — somem no mobile, onde o
	   hambúrguer já dá acesso aos mesmos links na sidebar. ---------- */
	.header-ctas {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		flex: none;
	}

	.header-ctas .btn {
		font-family: var(--font-display);
		font-weight: 600;
		white-space: nowrap;
	}

	/* ---------- hambúrguer (componente do DS, recolorido para header
	   escuro) com rótulo "Menu" ao lado ---------- */
	.hamburger_menu_wrapper {
		width: auto;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		position: relative;
		z-index: 50;
		cursor: pointer;
		background: none;
		border: 0;
		padding: 0;
		flex: none;
		color: var(--color-white);
	}

	.menu-label {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		transition: color 0.3s var(--ease-in-out);
	}

	.hamburger_menu_wrapper:hover .menu-label {
		color: var(--color-blush);
	}

	.hamburger_menu_wrapper > div {
		position: relative;
		width: 2rem;
		height: 2rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.hamburger_menu_wrapper > div span {
		display: block;
		height: 1.5px;
		width: 1.5rem;
		border-radius: 9999px;
		background: var(--color-white);
		transition: all 0.3s;
		position: relative;
	}

	.hamburger_menu_wrapper > div span:nth-child(1),
	.hamburger_menu_wrapper > div span:nth-child(2) {
		margin-bottom: 0.375rem;
	}

	.hamburger_menu_wrapper:hover > div span {
		background: var(--color-blush);
	}

	.hamburger_menu_wrapper > div.active span:nth-child(1) {
		animation: top 0.7s ease forwards;
	}
	.hamburger_menu_wrapper > div.not-active span:nth-child(1) {
		animation: top-2 0.7s ease forwards;
	}
	.hamburger_menu_wrapper > div.active span:nth-child(2) {
		animation: scaled 0.7s ease forwards;
	}
	.hamburger_menu_wrapper > div.not-active span:nth-child(2) {
		animation: scaled-2 0.7s ease forwards;
	}
	.hamburger_menu_wrapper > div.active span:nth-child(3) {
		animation: bottom 0.7s ease forwards;
	}
	.hamburger_menu_wrapper > div.not-active span:nth-child(3) {
		animation: bottom-2 0.7s ease forwards;
	}

	@keyframes top {
		0% {
			top: 0;
			transform: rotate(0);
		}
		50% {
			top: 7px;
			transform: rotate(0);
		}
		to {
			top: 7px;
			transform: rotate(45deg);
		}
	}
	@keyframes top-2 {
		0% {
			top: 8px;
			transform: rotate(45deg);
		}
		50% {
			top: 8px;
			transform: rotate(0);
		}
		to {
			top: 0;
			transform: rotate(0);
		}
	}
	@keyframes bottom {
		0% {
			bottom: 0;
			transform: rotate(0);
		}
		50% {
			bottom: 8px;
			transform: rotate(0);
		}
		to {
			bottom: 8px;
			transform: rotate(-45deg);
		}
	}
	@keyframes bottom-2 {
		0% {
			bottom: 9px;
			transform: rotate(-45deg);
		}
		50% {
			bottom: 9px;
			transform: rotate(0);
		}
		to {
			bottom: 0;
			transform: rotate(0);
		}
	}
	@keyframes scaled {
		50% {
			transform: scale(0);
		}
		to {
			transform: scale(0);
		}
	}
	@keyframes scaled-2 {
		0% {
			transform: scale(0);
		}
		50% {
			transform: scale(0);
		}
		to {
			transform: scale(1);
		}
	}

	/* ---------- overlay ---------- */
	.sidebar-overlay {
		position: fixed;
		inset: 0;
		z-index: 4998;
		background: rgba(31, 3, 4, 0.45);
		opacity: 0;
		transition: opacity 0.4s var(--ease-in-out);
	}

	.sidebar-overlay.is-visible {
		opacity: 1;
	}

	/* ---------- sidebar de vidro ---------- */
	.sidebar {
		position: fixed;
		inset: 0 0 0 auto;
		z-index: 4999;
		width: min(880px, 100vw);
		will-change: transform;
		/* Fundo quase opaco por padrão — esconde o conteúdo atrás mesmo
		   onde backdrop-filter não é suportado (alguns Chrome Android).
		   Onde é suportado, o @supports abaixo troca pro efeito vidro. */
		   background: linear-gradient(160deg, #2a0406 0%, #180203 60%, #120102 100%);
		will-change: transform;
		border-left: 1px solid rgba(255, 255, 255, 0.14);
		box-shadow: -40px 0 80px rgba(31, 3, 4, 0.35);
		transform: translateX(100%);
		transition: transform 0.5s var(--ease-in-out);
		overflow-y: auto;
		color: var(--color-white);
	}



	.sidebar.is-open {
		transform: translateX(0);
	}

	/* ---------- barra de rolagem da sidebar ----------
	   Fina, sem trilho visível e no tom do painel: o polegar é um traço de
	   4px (o "border" transparente + background-clip faz a área clicável
	   ficar de 12px sem engordar o desenho), fica discreto em repouso e
	   acende em blush ao passar o mouse / arrastar. scrollbar-gutter
	   reserva o espaço, então abrir um dropdown (que faz o conteúdo passar
	   a rolar) não empurra o layout 12px de lado. */
	.sidebar {
		scrollbar-gutter: stable;
		overscroll-behavior: contain;
	}

	.sidebar::-webkit-scrollbar {
		width: 12px;
	}

	.sidebar::-webkit-scrollbar-track {
		background: transparent;
		margin: 0.75rem 0;
	}

	.sidebar::-webkit-scrollbar-thumb {
		min-height: 48px;
		border: 4px solid transparent;
		border-radius: 9999px;
		background-color: rgba(255, 255, 255, 0.22);
		background-clip: padding-box;
		transition: background-color 0.25s var(--ease-in-out);
	}

	.sidebar::-webkit-scrollbar-thumb:hover,
	.sidebar::-webkit-scrollbar-thumb:active {
		background-color: var(--color-blush);
	}

	/* Firefox não lê ::-webkit-scrollbar; o Chrome moderno IGNORARIA o
	   desenho acima se scrollbar-color estivesse definido, por isso o
	   fallback fica restrito ao Firefox. */
	@supports (-moz-appearance: none) {
		.sidebar {
			scrollbar-width: thin;
			scrollbar-color: rgba(255, 255, 255, 0.28) transparent;
		}
	}

	/* Desktop: o botão de menu está à esquerda, então a sidebar abre da
	   esquerda pra direita. No mobile o hambúrguer continua à direita e a
	   sidebar segue abrindo pela direita. */
	@media (min-width: 900px) {
		.sidebar {
			inset: 0 auto 0 0;
			border-left: 0;
			border-right: 1px solid rgba(255, 255, 255, 0.14);
			box-shadow: 40px 0 80px rgba(31, 3, 4, 0.35);
			transform: translateX(-100%);
		}
	}

	.sidebar-inner {
		min-height: 100%;
		display: flex;
		flex-direction: column;
		padding: 2rem clamp(1.5rem, 5vw, 3rem) 3rem;
	}

	.sidebar-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 3rem;
	}

	.sidebar-top .kicker {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-rose-300);
	}

	.sidebar-grid {
		display: grid;
		grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
	}

	.sidebar-close {
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 9999px;
		border: 1px solid rgba(255, 255, 255, 0.32);
		background: transparent;
		color: var(--color-white);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition:
			background-color 0.3s var(--ease-in-out),
			border-color 0.3s var(--ease-in-out),
			transform 0.1s var(--ease-in-out);
	}

	.sidebar-close svg {
		width: 16px;
		height: 16px;
	}

	.sidebar-close:hover {
		background: var(--color-red-700);
		border-color: var(--color-red-700);
	}

	.sidebar-close:active {
		transform: scale(0.92);
	}

	.sidebar-nav {
		padding-left: clamp(2rem, 4vw, 3.5rem);
	}

	.sidebar-nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.sidebar-nav > ul > li {
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
	}

	.sidebar-nav > ul > li:first-child {
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.nav-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	/* O título de um item com dropdown não é mais link — o rótulo e a
	   seta viram um único botão de toggle, então o reset abaixo só
	   entra quando .nav-row É o próprio botão. */
	button.nav-row {
		width: 100%;
		border: 0;
		background: none;
		padding: 0;
		cursor: pointer;
		text-align: left;
		font: inherit;
	}

	.nav-row a,
	.nav-row span {
		flex: 1 1 auto;
		display: block;
		padding: 1.1rem 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.375rem;
		color: var(--color-white);
		text-decoration: none;
		transition: color 0.3s var(--ease-in-out);
	}

	.nav-row a:hover,
	.dropdown-toggle:hover span {
		color: var(--color-blush);
	}

	.dropdown-toggle svg {
		flex: none;
		width: 18px;
		height: 18px;
		color: var(--color-rose-300);
		transition:
			transform 0.35s var(--ease-in-out),
			color 0.3s var(--ease-in-out);
	}

	.dropdown-toggle:hover svg {
		color: var(--color-blush);
	}

	li.has-dropdown.is-open .dropdown-toggle svg {
		transform: rotate(180deg);
	}

	.dropdown {
		max-height: 0;
		overflow: hidden;
		transition: max-height 0.4s var(--ease-in-out);
	}

	.dropdown li a {
		display: block;
		padding: 0.7rem 0 0.7rem 1.25rem;
		font-family: var(--font-body);
		font-size: 0.9375rem;
		color: var(--color-rose-200);
		text-decoration: none;
		border-left: 1px solid rgba(255, 255, 255, 0.18);
		transition: color 0.3s var(--ease-in-out);
	}

	.dropdown li a[aria-current="page"],
	.nav-dropdown li a[aria-current="page"] {
		color: var(--color-white);
		border-left-color: var(--color-blush);
	}

	.dropdown li a:hover {
		color: var(--color-white);
	}

	.dropdown li:last-child a {
		padding-bottom: 1.1rem;
	}

	/* ---------- informações do evento ---------- */
	.sidebar-info {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding-right: clamp(2rem, 4vw, 3.5rem);
		border-right: 1px solid rgba(255, 255, 255, 0.14);
	}

	.info-block .kicker {
		display: block;
	}

	.info-date {
		display: flex;
		align-items: baseline;
		gap: 0.625rem;
		margin-top: 0.85rem;
		font-family: var(--font-display);
		color: var(--color-white);
	}

	.info-date strong {
		font-size: 2.25rem;
		line-height: 1;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}

	.info-month {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.8125rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-blush);
	}

	.info-duration {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 0.6rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-rose-300);
	}

	.info-duration .dash {
		width: 28px;
		height: 1px;
		background: rgba(255, 255, 255, 0.4);
		flex: none;
	}

	.info-hours {
		margin-top: 0.6rem;
		font-family: var(--font-body);
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--color-rose-200);
	}

	.info-venue {
		margin-top: 0.85rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.1875rem;
		color: var(--color-white);
	}

	.info-address {
		margin-top: 0.375rem;
		max-width: 26ch;
		font-family: var(--font-body);
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--color-rose-200);
	}

	.info-logos {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 1rem;
	}

	/* Logos de parceiros mantêm a cor original — em vez de forçar
	   monocromia, ganham um cartão branco para garantir contraste sobre
	   o vidro escuro sem destruir o próprio desenho da marca. */
	.logo-chip {
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 0.75rem;
		border-radius: 2px;
		transition: transform 0.25s var(--ease-in-out);
	}

	.logo-chip:hover {
		transform: translateY(-2px);
	}

	.info-logos img {
		height: 40px;
		width: auto;
		display: block;
	}

	/* ---------- pontos de quebra da barra superior — prioridade:
	   contagem > local > data > redes sociais.
	   Medidos no navegador (ver seção 9 do briefing), não arredondar. ---------- */
	@media (max-width: 1799px) {
		.socials {
			display: none;
		}
	}

	@media (max-width: 1675px) {
		.addr-full {
			display: none;
		}
		.addr-mid {
			display: inline;
		}
	}

	@media (max-width: 1484px) {
		.dur {
			display: none;
		}
	}

	/* eventos simultâneos + atalhos (centro da barra principal) somem
	   juntos: sem os links de atalho, o selo sozinho fica sem função —
	   o hambúrguer já dá acesso aos mesmos links e à mesma info na
	   sidebar abaixo dessa largura. Medido no navegador: abaixo de
	   1600px o grupo (com marca + CTAs + hambúrguer nas pontas) não
	   cabe mais numa linha só. */
	@media (max-width: 1610px) {
		.mb-center {
			display: none;
		}
	}

	@media (max-width: 1431px) {
		.addr-mid {
			display: none;
		}
		.addr-short {
			display: inline;
		}
	}

	/* abaixo disso não cabe tudo lado a lado: letreiro rotativo */
	@media (max-width: 1328px) {
		.tb-inner {
			position: relative;
			justify-content: center;
		}

		.tb-sep {
			display: none;
		}

		.tb-item {
			position: absolute;
			left: 50%;
			top: 50%;
			transform: translate(-50%, -30%);
			opacity: 0;
			visibility: hidden;
			max-width: calc(100% - 2.5rem);
			transition:
				opacity 0.45s var(--ease-out),
				transform 0.45s var(--ease-out),
				visibility 0s 0.45s;
		}

		.tb-item.is-active {
			opacity: 1;
			visibility: visible;
			transform: translate(-50%, -50%);
			transition:
				opacity 0.45s var(--ease-out),
				transform 0.45s var(--ease-out),
				visibility 0s;
		}

		.tb-venue .addr-mid {
			display: none;
		}
		.tb-venue .addr-short {
			display: inline;
		}

		.dur {
			display: inline;
		} /* no letreiro sobra espaço: o "4 dias" volta */
	}

	/* Abaixo disso o header fica apertado demais pros dois botões de
	   texto ao lado da marca + ícones sociais + hambúrguer — o hambúrguer
	   já dá acesso aos mesmos links (Quero Expor/Quero Visitar) na
	   sidebar, então eles só somem daqui. */
	@media (max-width: 899px) {
		.header-ctas {
			display: none;
		}
	}

	/* Desktop: inverte as pontas — ações (selo + CTAs + menu) à esquerda e
	   marca à direita. Só `order` no CSS, então o DOM (e a ordem de foco
	   no mobile) continua o mesmo. */
	@media (min-width: 900px) {
		.mb-actions {
			order: 1;
			margin-left: 0;
		}

		/* menu na ponta esquerda, antes dos CTAs */
		.hamburger_menu_wrapper {
			order: -1;
			flex-direction: row-reverse; /* ícone antes do rótulo */
		}

		/* o selo é invisível fora do modo compacto mas ocupa espaço: vai pro
		   fim do grupo pra não empurrar os botões da margem esquerda. */
		.cd-chip {
			order: 1;
		}

		/* links no centro geométrico da barra, independente da largura das
		   ações (esquerda) e da marca (direita), que são diferentes. */
		.mb-inner {
			position: relative;
		}

		.mb-center {
			position: absolute;
			left: 50%;
			top: 50%;
			transform: translate(-50%, -50%);
		}

		.brand {
			order: 3;
			margin-left: auto;
		}

		/* logos maiores no desktop (a barra tem 120px / 104px compacta) */
		.brand img {
			height: 68px;
		}

		.site-header.is-compact .brand img {
			height: 54px;
		}

		.brand-divider {
			height: 40px;
		}
	}

	@media (max-width: 639px) {
		.tb-meta,
		.cd-msg,
		.tb-meta .muted,
		.sim-label {
			font-size: 0.8125rem;
		}
		.tb-meta svg {
			width: 16px;
			height: 16px;
		}
		.countdown {
			gap: 0.55rem;
		}
		.cd-label {
			font-size: 0.6875rem;
		}
		.cd-units {
			gap: 0.3rem;
		}
		.cd-unit {
			padding: 0.22rem 0.4rem;
			gap: 0.18rem;
		}
		.cd-num {
			font-size: 1rem;
		}
		.cd-u {
			font-size: 0.5625rem;
		}
		.mb-inner {
			gap: 1rem;
		}
		.menu-label {
			display: none;
		}
		.site-header.is-compact .brand img {
			height: 36px;
		}

		/* o selo não pode ocupar espaço invisível no celular (ver aviso
		   da seção 6): com opacity:0 ele continua no fluxo e empurra o
		   botão do menu pra fora da tela — por isso display:none, não
		   opacity. */
		.cd-chip {
			display: none;
			padding: 0.3rem 0.6rem;
			font-size: 0.6875rem;
			gap: 0.4rem;
		}
		.site-header.is-compact .cd-chip {
			display: flex;
		}
		.chip-full {
			display: none;
		}
		.chip-short {
			display: inline;
		}
	}

	@media (max-width: 480px) {
		.brand {
			gap: 0.625rem;
		}

		.brand img {
			height: 42px;
		}

		.brand-divider {
			height: 24px;
		}

		.sidebar-inner {
			padding: 1.5rem 1.25rem 2.5rem;
		}

		.nav-row a,
		.nav-row span {
			font-size: 1.2rem;
		}
	}

	@media (max-width: 399px) {
		.cd-label {
			display: none;
		}
	}

	@media (max-width: 379px) {
		.site-header.is-compact .cd-chip {
			display: none;
		}
	}

	@media (max-width: 359px) {
		.tb-venue .addr {
			display: none;
		}
	}

	@media (max-width: 720px) {
		.sidebar-grid {
			grid-template-columns: 1fr;
		}

		.sidebar-nav {
			padding-left: 0;
			order: 1;
		}

		.sidebar-info {
			padding-right: 0;
			border-right: 0;
			padding-top: 2rem;
			margin-top: 2.5rem;
			border-top: 1px solid rgba(255, 255, 255, 0.14);
			order: 2;
		}
	}
</style>

<script>
	/* ---------- datas do evento: ÚNICO lugar para ajustar ----------
	   ⚠️ Confirme as datas reais do evento antes de publicar. */
	const EVENT_START = new Date("2028-09-12T13:00:00-03:00");
	const EVENT_END = new Date("2028-09-15T20:00:00-03:00");

	const header = document.getElementById("site-header");
	const cd = document.getElementById("countdown");
	if (header && cd) {
		const T = cd.dataset;
		const fill = (tpl: string | undefined, d: number) =>
			(tpl ?? "").replace("{d}", String(d));
		const num = (k: string) =>
			cd.querySelector<HTMLElement>(`[data-cd="${k}"]`)!;
		const els = { d: num("d"), h: num("h"), m: num("m"), s: num("s") };
		const msg = document.getElementById("cd-msg")!;
		const sr = document.getElementById("cd-sr")!;
		const chipD = header.querySelector<HTMLElement>('[data-chip="d"]')!;
		const chipT = header.querySelector<HTMLElement>('[data-chip="t"]')!;
		const chipShort = header.querySelector<HTMLElement>(
			'[data-chip="short"]',
		)!;
		const chipFull = header.querySelector<HTMLElement>(".chip-full")!;
		const pad = (n: number) => String(n).padStart(2, "0");
		let lastSr = "";

		const set = (el: HTMLElement, v: string) => {
			if (el.textContent === v) return; // só mexe no que mudou
			el.textContent = v;
			el.classList.remove("tick");
			void el.offsetWidth;
			el.classList.add("tick");
		};

		const render = () => {
			const now = new Date();
			const state =
				now < EVENT_START ? "before" : now <= EVENT_END ? "live" : "after";
			cd.dataset.state = state;
			if (state === "before") {
				const t = Math.floor((+EVENT_START - +now) / 1000);
				const d = Math.floor(t / 86400),
					h = Math.floor((t % 86400) / 3600),
					m = Math.floor((t % 3600) / 60),
					s = t % 60;
				set(els.d, String(d));
				set(els.h, pad(h));
				set(els.m, pad(m));
				set(els.s, pad(s));
				chipFull.hidden = false;
				chipD.textContent = String(d);
				chipT.textContent = `${pad(h)}:${pad(m)}:${pad(s)}`;
				chipShort.textContent = fill(T.chipDays, d);
				const txt = fill(T.srBefore, d);
				if (txt !== lastSr) {
					sr.textContent = txt;
					lastSr = txt;
				} // leitor de tela: só quando o DIA muda
			} else {
				const live = state === "live";
				msg.textContent = live
					? (T.live ?? "")
						: (T.after ?? "");
				chipFull.hidden = true;
				chipShort.textContent = (live ? T.chipLive : T.chipAfter) ?? "";
				sr.textContent = msg.textContent;
			}
		};

		/* recalcula a partir do relógio a cada tick: não acumula atraso */
		render();
		let timer = window.setInterval(render, 1000);
		document.addEventListener("visibilitychange", () => {
			clearInterval(timer);
			if (!document.hidden) {
				render();
				timer = window.setInterval(render, 1000);
			}
		});

		/* ---------- letreiro da barra superior (≤1328px) ---------- */
		const items = [...header.querySelectorAll<HTMLElement>(".tb-item")];
		const tickerMq = matchMedia("(max-width:1328px)");
		const reduceMq = matchMedia("(prefers-reduced-motion: reduce)");
		const tbInner = document.getElementById("tb-inner")!;
		let idx = 0,
			tTimer = 0,
			paused = false;
		const show = (i: number) =>
			items.forEach((el, k) => el.classList.toggle("is-active", k === i));
		const startTicker = () => {
			clearInterval(tTimer);
			idx = 0;
			show(0);
			if (!tickerMq.matches || reduceMq.matches) return; // reduzir movimento: fica na contagem
			tTimer = window.setInterval(() => {
				if (!paused) {
					idx = (idx + 1) % items.length;
					show(idx);
				}
			}, 3800);
		};
		// pausa SÓ com mouse de verdade — em toque, "pointerenter" dispara
		// ao tocar e "pointerleave" nunca dispara, travando o letreiro.
		tbInner.addEventListener("pointerenter", (e) => {
			if (e.pointerType === "mouse") paused = true;
		});
		tbInner.addEventListener("pointerleave", (e) => {
			if (e.pointerType === "mouse") paused = false;
		});
		tbInner.addEventListener("focusin", () => {
			paused = true;
		});
		tbInner.addEventListener("focusout", () => {
			paused = false;
		});
		tickerMq.addEventListener("change", startTicker);
		startTicker();

		/* ---------- compacta o header ao rolar ---------- */
		const onScroll = () =>
			header.classList.toggle("is-compact", window.scrollY > 24);
		window.addEventListener("scroll", onScroll, { passive: true });
		onScroll();
	}

	const toggle = document.getElementById(
		"menu-toggle",
	) as HTMLButtonElement | null;
	const closeBtn = document.getElementById("sidebar-close");
	const overlay = document.getElementById("sidebar-overlay");
	const sidebar = document.getElementById("site-sidebar");
	const burgerState = toggle?.querySelector("div");

	const openSidebar = () => {
		sidebar?.classList.add("is-open");
		overlay?.removeAttribute("hidden");
		requestAnimationFrame(() => overlay?.classList.add("is-visible"));
		sidebar?.setAttribute("aria-hidden", "false");
		toggle?.setAttribute("aria-expanded", "true");
		burgerState?.classList.remove("not-active");
		burgerState?.classList.add("active");
		document.documentElement.style.overflow = "hidden";
	};

	const closeSidebar = () => {
		sidebar?.classList.remove("is-open");
		overlay?.classList.remove("is-visible");
		sidebar?.setAttribute("aria-hidden", "true");
		toggle?.setAttribute("aria-expanded", "false");
		burgerState?.classList.remove("active");
		burgerState?.classList.add("not-active");
		document.documentElement.style.overflow = "";
		setTimeout(() => {
			if (!sidebar?.classList.contains("is-open"))
				overlay?.setAttribute("hidden", "");
		}, 400);
	};

	toggle?.addEventListener("click", () => {
		const isOpen = sidebar?.classList.contains("is-open");
		isOpen ? closeSidebar() : openSidebar();
	});

	closeBtn?.addEventListener("click", closeSidebar);
	overlay?.addEventListener("click", closeSidebar);

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeSidebar();
	});

	sidebar
		?.querySelectorAll<HTMLElement>("li.has-dropdown")
		.forEach((item) => {
			const dropToggle =
				item.querySelector<HTMLButtonElement>(".dropdown-toggle");
			const drop = item.querySelector<HTMLElement>(".dropdown");

			dropToggle?.addEventListener("click", () => {
				const isOpen = item.classList.toggle("is-open");
				dropToggle.setAttribute("aria-expanded", String(isOpen));
				if (drop)
					drop.style.maxHeight = isOpen
						? `${drop.scrollHeight}px`
						: "";
			});
		});
</script>
