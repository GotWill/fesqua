---
// Hero de páginas internas: papel milimetrado + título em duas linhas + ícone da janela.
import JanelaDraw from './JanelaDraw.astro';

interface Props {
	lineA: string;
	lineB: string;
	lineC?: string;
	id?: string;
}
const { lineA, lineB, lineC, id = 'page-title' } = Astro.props;
---

<section class="hero" aria-labelledby={id}>
	<div class="hero-inner">
		<h1 class="hero-h1" id={id}><span class="l1">{lineA}</span> <span class="l2">{lineB}</span>{lineC && <> <span class="l2">{lineC}</span></>}</h1>
		<JanelaDraw color="var(--color-primary)" size="110px" class="hero-janela" />
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background-color: var(--color-rose-50);
		border-bottom: 1px solid var(--color-line);
		background-image:
			linear-gradient(rgba(156, 12, 12, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(156, 12, 12, 0.06) 1px, transparent 1px),
			linear-gradient(rgba(156, 12, 12, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(156, 12, 12, 0.035) 1px, transparent 1px);
		background-size: 96px 96px, 96px 96px, 24px 24px, 24px 24px;
	}
	.hero-inner {
		max-width: 1040px;
		margin-inline: auto;
		padding: 4.5rem clamp(1.25rem, 4vw, 3rem) 4rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}
	.hero-h1 {
		font-family: var(--font-display);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.01em;
		font-size: clamp(1.625rem, 4.6vw, 3.75rem);
		color: var(--color-primary);
	}
	.hero-h1 span {
		display: block;
	}
	.hero-h1 .l2 {
		color: var(--color-text);
	}
	/* o ícone é de outro componente. Precisa de :global E de um ancestral na frente
	   (.hero-inner): o CSS do próprio ícone tem seletor mais forte e ganharia. */
	.hero-inner :global(.hero-janela) {
		flex: none;
	}
	@media (max-width: 560px) {
		.hero-inner :global(.hero-janela) {
			display: none;
		}
	}
</style>
