---
import fs from 'node:fs';
import path from 'node:path';

const LOGOS_DIR = path.resolve('public/images/logos');
const logoFiles = fs.readdirSync(LOGOS_DIR);

function resolveLogo(name: string): string {
	const match = logoFiles.find((f) => path.parse(f).name === name);
	if (!match) {
		throw new Error(`Logo "${name}" não encontrada em public/images/logos (arquivos disponíveis: ${logoFiles.join(', ')})`);
	}
	return `/images/logos/${match}`;
}

interface Partner {
	name: string;
	logo?: string;
	url: string;
	featured?: boolean;
}

interface PartnerTab {
	id: string;
	label: string;
	countLabel: string;
	partners: Partner[];
}

